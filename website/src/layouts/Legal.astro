---
// Long-form pages (privacy policy, terms of use): one column of text over the quiet backdrop.
import Base from "./Base.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props { lang: Lang; path: string; title: string; description: string; updated: string }
const { lang, path, title, description, updated } = Astro.props;
const t = ui[lang];
const date = new Date(updated).toLocaleDateString(lang === "fr" ? "fr-FR" : "en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base lang={lang} path={path} title={title} description={description} scene="calm">
  <article class="legal wrap">
    <header class="legal-head reveal">
      <p class="eyebrow">Windows Ultimate</p>
      <h1>{title}</h1>
      <p class="updated">{t.legal.updated}{lang === "fr" ? " : " : ": "}<time datetime={updated}>{date}</time></p>
    </header>
    <div class="prose reveal" data-delay="1">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal { max-width: 780px; padding-block: clamp(48px, 8vw, 110px) clamp(80px, 10vw, 140px); }
  .legal-head h1 { font-size: clamp(2.3rem, 5vw, 3.6rem); margin: 20px 0 14px; letter-spacing: -0.04em; }
  .updated { color: var(--text-3); font-size: 12.5px; }
  .prose { margin-top: 48px; color: var(--text-2); font-size: 16.5px; line-height: 1.7; }
  .prose :global(h2) { color: var(--text); font-size: 1.35rem; letter-spacing: -0.02em; margin: 48px 0 14px; line-height: 1.25; }
  .prose :global(h3) { color: var(--text); font-size: 1.05rem; letter-spacing: -0.01em; margin: 28px 0 8px; }
  .prose :global(p + p) { margin-top: 14px; }
  .prose :global(ul) { display: grid; gap: 8px; margin: 14px 0; }
  .prose :global(li) { position: relative; padding-left: 20px; }
  .prose :global(li::before) { content: ""; position: absolute; left: 0; top: 0.8em; width: 8px; height: 1px; background: var(--accent-bright); }
  .prose :global(a) { color: var(--text); text-decoration: none; background: linear-gradient(rgb(125 180 255 / 0.55), rgb(125 180 255 / 0.55)) 0 100% / 100% 1px no-repeat; transition: color 0.2s; }
  .prose :global(a:hover) { color: var(--accent-bright); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(code) { font-size: 0.86em; padding: 2px 6px; border-radius: 6px; background: rgb(255 255 255 / 0.06); color: var(--silver); word-break: break-word; }
  .prose :global(.summary) { padding: 22px 24px; border-radius: 16px; background: var(--glass); box-shadow: 0 0 0 1px var(--line-strong) inset; color: var(--silver); }
</style>
