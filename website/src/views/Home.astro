<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Tabs (gaming profiles, tour): one selected, arrow keys move between them.
  const tabs = (list: HTMLElement, onSelect: (i: number, user: boolean) => void) => {
    const items = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (i: number, user: boolean, focus = false) => {
      items.forEach((b, k) => {
        b.setAttribute("aria-selected", String(k === i));
        b.tabIndex = k === i ? 0 : -1;
      });
      if (focus) items[i].focus();
      onSelect(i, user);
    };
    items.forEach((b, i) => {
      b.addEventListener("click", () => select(i, true));
      b.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (e.key === "Home" || e.key === "End") {
          e.preventDefault();
          select(e.key === "Home" ? 0 : items.length - 1, true, true);
        } else if (d) {
          e.preventDefault();
          select((i + d + items.length) % items.length, true, true);
        }
      });
    });
    return { select, items };
  };
  const showPanel = (panels: HTMLElement[], i: number) => panels.forEach((p, k) => (p.hidden = k !== i));
  // In a rail that scrolls sideways (phones), bring the selected item to the middle without moving the page.
  const center = (rail: HTMLElement, item: HTMLElement) => {
    if (rail.scrollWidth <= rail.clientWidth) return;
    const r = rail.getBoundingClientRect();
    const b = item.getBoundingClientRect();
    rail.scrollTo({ left: rail.scrollLeft + b.left - r.left - (r.width - b.width) / 2, behavior: reduced ? "auto" : "smooth" });
  };

  // Gaming profiles.
  document.querySelectorAll<HTMLElement>("[data-picker]").forEach((root) => {
    const panels = [...root.querySelectorAll<HTMLElement>(".pk-panel")];
    tabs(root.querySelector(".pk-list")!, (i) => showPanel(panels, i));
  });

  // Tour: the ink follows the selected tab.
  document.querySelectorAll<HTMLElement>("[data-tour]").forEach((root) => {
    const list = root.querySelector<HTMLElement>(".tour-tabs")!;
    const ink = root.querySelector<HTMLElement>(".tour-ink")!;
    const panels = [...root.querySelectorAll<HTMLElement>(".tour-panel")];
    let current = 0;
    const place = () => {
      const b = items[current];
      ink.style.width = `${b.offsetWidth}px`;
      ink.style.transform = `translateX(${b.offsetLeft}px)`;
    };
    const { items } = tabs(list, (i) => {
      current = i;
      showPanel(panels, i);
      place();
      center(list, items[i]);
    });
    place();
    addEventListener("resize", place);
    document.fonts?.ready.then(place);
  });

  // Repair terminal: a soft highlight walks down the tools while it is on screen.
  if (!reduced) {
    document.querySelectorAll<HTMLElement>("[data-cycle]").forEach((root) => {
      const lines = [...root.querySelectorAll<HTMLElement>(".term-lines li")];
      let i = -1;
      setInterval(() => {
        if (!root.classList.contains("live") || root.matches(":hover")) return;
        lines[i]?.classList.remove("cur");
        i = (i + 1) % lines.length;
        lines[i].classList.add("cur");
      }, 1500);
    });
  }

  // Hero: the layers follow the pointer a little, each by its depth.
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  if (stage && !reduced && matchMedia("(hover: hover) and (pointer: fine) and (min-width: 1100px)").matches) {
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const step = () => {
      x += (tx - x) * 0.07;
      y += (ty - y) * 0.07;
      stage.style.setProperty("--mx", x.toFixed(3));
      stage.style.setProperty("--my", y.toFixed(3));
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.002 ? requestAnimationFrame(step) : 0;
    };
    addEventListener("pointermove", (e) => {
      if (!stage.classList.contains("live")) return;
      tx = (e.clientX / innerWidth - 0.5) * 2;
      ty = (e.clientY / innerHeight - 0.5) * 2;
      if (!raf) raf = requestAnimationFrame(step);
    }, { passive: true });
  }
</script>
