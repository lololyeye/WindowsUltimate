  }

  /* ───────── The problem ───────── */
  .problem { padding-top: clamp(72px, 9vw, 128px); }
  /* The statement lights up as it is read (scripts/motion.ts). */
  .statement { margin-top: 24px; max-width: 30ch; font-size: var(--fs-h2); font-weight: 600; line-height: 1.15; letter-spacing: -0.035em; }
  .statement :global(.sw) { color: rgb(201 209 221 / 0.22); transition: color 0.5s var(--ease); }
  .statement :global(.sw.on) { color: var(--text); }

  /* Point by point: each usual promise against what the app does instead. */
  .versus { width: 100%; margin-top: clamp(48px, 7vw, 88px); border-collapse: collapse; table-layout: fixed; }
  .versus th { padding: 0 0 14px; text-align: left; font-size: var(--fs-label); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); }
  .versus th + th { color: var(--accent-bright); padding-left: clamp(20px, 4vw, 56px); }
  .versus th :global(.vs-mark) { display: inline-block; width: 18px; height: 18px; margin: -4px 10px 0 0; vertical-align: middle; }
  .versus td { padding: 18px 0; border-top: 1px solid var(--line); vertical-align: top; font-size: 1.02rem; line-height: 1.5; }
  .versus td + td { padding-left: clamp(20px, 4vw, 56px); border-left: 1px solid var(--line); }
  .vc { display: flex; gap: 14px; }
  .vs-usual { color: var(--text-3); }
  .vs-n { flex: none; font-size: 12px; padding-top: 4px; color: var(--text-3); }
  .vs-ours { color: var(--text); }
  .vs-ours :global(.icon) { width: 18px; height: 18px; flex: none; margin-top: 3px; color: var(--success); }
  /* Each usual promise is struck through, row after row, as the table arrives. */
  .vs-x { background: linear-gradient(rgb(240 96 90 / 0.5), rgb(240 96 90 / 0.5)) 0 58% / 0% 1.5px no-repeat; transition: background-size 0.6s var(--ease) calc(0.4s + var(--i) * 0.14s); }
  :global(.js) .versus.in .vs-x, :global(html:not(.js)) .vs-x { background-size: 100% 1.5px; }
  .versus tr { transition: opacity 0.6s var(--ease) calc(var(--i) * 0.08s); }
