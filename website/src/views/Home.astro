---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import Shot from "../components/Shot.astro";
import ReleaseSync from "../components/ReleaseSync.astro";
import { ui, type Lang } from "../i18n/ui";
import { GITHUB_URL, RELEASES_URL, pageHref } from "../lib/site";
import { latestRelease, version, formatSize, formatDate, sha256 } from "../lib/release";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const f = t.features;
const release = await latestRelease();
const v = version(release);
const size = formatSize(release.asset.size, lang);
const hash = sha256(release);
const home = pageHref(lang);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Windows Ultimate",
  operatingSystem: "Windows 11",
  applicationCategory: "UtilitiesApplication",
  softwareVersion: v,
  description: t.meta.description,
  downloadUrl: release.asset.url,
  fileSize: size,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  url: new URL(home, Astro.site).href,
  codeRepository: GITHUB_URL,
};

const pad = (i: number) => String(i).padStart(2, "0");
// Gauge ticks behind the hero window, like the health dial in the app.
const ticks = Array.from({ length: 120 }, (_, i) => i);
const tags: Record<string, string> = { ro: f.repair.readOnly, mod: f.repair.modifies, net: f.repair.internet };
const tagClass: Record<string, string> = { ro: "safe", mod: "mod", net: "info" };
const tierClass = ["safe", "info", "mod", "lock"];
const levelClass = ["safe", "low", "mod", "adv", "bad"];
const moreIcons = ["network", "eye", "gauge", "chip", "history", "globe"] as const;
const coverIcons = ["bolt", "pad", "gauge", "trash", "disk", "wrench", "chip", "undo"] as const;
const maxChanges = Math.max(...f.gaming.profileList.map((p) => p[2]));

// The instrument strip of the Monitoring chapter is an illustration: smooth, seeded curves, not data.
// Each path is two identical periods wide so it can slide forever without a seam.
const wave = (seed: number, base: number, amp: number) => {
  const pts: string[] = [];
  const n = 24;
  for (let i = 0; i <= n * 2; i++) {
    const k = (i % n) / n;
    const y = base - amp * (0.55 * Math.sin(2 * Math.PI * (k * 2 + seed)) + 0.3 * Math.sin(2 * Math.PI * (k * 5 + seed * 1.7)) + 0.15 * Math.sin(2 * Math.PI * (k * 9 + seed * 3.1)));
    pts.push(`${((i / (n * 2)) * 400).toFixed(1)},${y.toFixed(1)}`);
  }
  return `M${pts.join(" L")}`;
};
const meters = f.monitor.metrics.map(([k, d], i) => ({ k, d, path: wave(i * 0.37 + 0.1, [34, 40, 22, 44, 36, 30][i], [12, 9, 4, 10, 11, 5][i]) }));

const segTotal = f.storage.segments.reduce((a, s) => a + s[3], 0);
const tour = f.tour.pages;
const tourShot = (key: string) => (key === "dashboard" ? "dashboard" : `win-${key}`);
---
<Base lang={lang} path="" jsonLd={jsonLd}>
  <!-- ───────── Hero ───────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-mark" aria-hidden="true">
          <span class="hm-halo"></span>
          <svg class="hm-orbit" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" pathLength="1" /></svg>
          <Logo id="hero" class="hm-logo" />
          <span class="hm-sheen"></span>
        </div>
        <p class="eyebrow hero-eyebrow"><span>Windows Ultimate <span data-r="version">{v}</span> · {t.hero.eyebrowOs}</span></p>
        <h1 id="hero-title">
          <span class="h1-a">{t.hero.title1}</span>
          <span class="glow-text h1-b" data-word>{t.hero.title2}</span>
        </h1>
        <p class="lead hero-lead">{t.hero.lead}</p>
        <div class="cta hero-cta">
          <a class="btn btn-primary btn-lg" href="#download">
            <Icon name="download" class="arrow" />{t.hero.download}
          </a>
          <a class="btn btn-glass btn-lg" href="#features">{t.hero.explore}<Icon name="arrow" class="chev" /></a>
        </div>
        <p class="hero-meta mono">{t.hero.meta(size)}</p>
      </div>

      <div class="hero-stage" data-stage data-live>
        <div class="stage-glow" aria-hidden="true"></div>
        <svg class="gauge" viewBox="-500 -500 1000 1000" aria-hidden="true" focusable="false">
          <circle r="470" fill="none" stroke="rgb(160 190 235 / 0.08)" />
          <circle r="330" fill="none" stroke="rgb(160 190 235 / 0.06)" stroke-dasharray="2 10" />
          <g stroke="rgb(160 190 235 / 0.22)" stroke-linecap="round">
            {ticks.map((i) => <line x1="0" y1="-470" x2="0" y2={i % 10 === 0 ? -440 : -458} transform={`rotate(${i * 3})`} stroke-width={i % 10 === 0 ? 2 : 1} />)}
          </g>
          <path d="M -332 -332 A 470 470 0 0 1 332 -332" fill="none" stroke="url(#gauge-arc)" stroke-width="3" stroke-linecap="round" />
          <defs>
            <linearGradient id="gauge-arc" x1="-332" y1="0" x2="332" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#3d8bff" stop-opacity="0" />
              <stop offset="0.5" stop-color="#7db4ff" />
              <stop offset="1" stop-color="#8a72f0" stop-opacity="0" />
            </linearGradient>
          </defs>
        </svg>
        <div class="slab" aria-hidden="true"></div>
        <figure class="window">
          <div class="window-frame">
            <Shot lang={lang} name="dashboard" alt={t.hero.shotAlt} sizes="(min-width: 1100px) 64vw, 94vw" widths={[800, 1200, 1600]} eager class="window-img" />
            <span class="window-sheen" aria-hidden="true"></span>
            <span class="window-scan" aria-hidden="true"></span>
          </div>
          <figcaption class="mono">{t.hero.caption}</figcaption>
        </figure>
        <figure class="float f-health" style="--d: 18">
          <Shot lang={lang} name="d-health" alt={t.hero.healthAlt} sizes="(min-width: 1100px) 220px, 34vw" widths={[350]} eager />
        </figure>
        <figure class="float f-recs" style="--d: 11">
          <Shot lang={lang} name="d-recs" alt={t.hero.recsAlt} sizes="(min-width: 1100px) 520px, 70vw" widths={[600, 902]} eager />
        </figure>
        <p class="float chip c-user" style="--d: 26" aria-hidden="true"><span class="led"></span>{t.hero.chipUser}</p>
        <div class="floor" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ───────── The problem ───────── -->
  <section id="overview" class="problem" aria-labelledby="overview-title">
    <div class="wrap">
      <p class="eyebrow reveal"><span class="idx">01</span> {t.problem.eyebrow}</p>
      <h2 id="overview-title" class="statement" data-scrub>{t.overview.statement}</h2>

      <div class="versus">
        <div class="vs vs-usual reveal">
          <p class="vs-title mono">{t.problem.usualTitle}</p>
          <ul>{t.problem.usual.map((x, i) => <li style={`--i:${i}`}><Icon name="x" /><span>{x}</span></li>)}</ul>
        </div>
        <div class="vs-arrow reveal" data-delay="1" aria-hidden="true"><Icon name="arrow" /></div>
        <div class="vs vs-ours glass glass-3 spot reveal" data-delay="2">
          <p class="vs-title mono"><Logo id="vs" class="vs-mark" />{t.problem.oursTitle}</p>
          <ul>{t.problem.ours.map((x, i) => <li style={`--i:${i}`}><Icon name="check" /><span>{x}</span></li>)}</ul>
        </div>
      </div>

      <div class="myths reveal">
        <div>
          <h3>{t.trust.mythsTitle}</h3>
          <p>{t.trust.mythsLead}</p>
        </div>
        <ul data-stagger>
          {t.trust.myths.map((m) => <li><s>{m}</s></li>)}
        </ul>
      </div>

      <div class="cover">
        <p class="cover-title mono reveal">{t.problem.coverTitle}</p>
        <ol class="cover-grid" data-stagger>
          {t.overview.items.map(([title, text], i) => (
            <li class="spot">
              <span class="cv-icon"><Icon name={coverIcons[i]} /></span>
              <div><h3>{title}</h3><p>{text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ───────── Features ───────── -->
  <section id="features" class="features" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">02</span> {f.eyebrow}</p>
        <h2 id="features-title">{f.title}</h2>
        <p>{f.lead}</p>
      </div>
    </div>

    <!-- Gaming: the real profiles, and a picker that reads them out. -->
    <article class="chapter ch-gaming" aria-labelledby="ch-gaming">
      <div class="wrap">
        <div class="ch-grid">
          <div class="ch-copy reveal">
            <p class="ch-label"><span class="ch-idx mono">{f.gaming.idx}</span>{f.gaming.label}</p>
            <h3 id="ch-gaming">{f.gaming.title}</h3>
            <p class="ch-text">{f.gaming.text}</p>
            <ul class="ticks">
              {f.gaming.points.map((p) => <li><Icon name="check" />{p}</li>)}
            </ul>
          </div>
          <div class="ch-visual gaming-visual">
            <figure class="panel g-profiles reveal" data-delay="1">
              <Shot lang={lang} name="d-profiles" alt={f.gaming.profilesAlt} sizes="(min-width: 1000px) 58vw, 94vw" widths={[640, 960, 1268]} />
            </figure>
            <figure class="panel g-analysis reveal" data-delay="2" data-parallax="-0.06">
              <Shot lang={lang} name="d-analysis" alt={f.gaming.analysisAlt} sizes="(min-width: 1000px) 30vw, 80vw" widths={[400, 626]} />
            </figure>
          </div>
        </div>

        <div class="picker glass reveal" data-picker>
          <div class="pk-head">
            <p class="pk-title">{f.gaming.pickTitle}</p>
            <p class="pk-hint">{f.gaming.pickHint}</p>
          </div>
          <div class="pk-list" role="tablist" aria-label={f.gaming.pickTitle}>
            {f.gaming.profileList.map(([name], i) => (
              <button type="button" role="tab" id={`pk-tab-${i}`} aria-controls={`pk-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                <span class="pk-dot"></span>{i === 0 && <Icon name="bolt" class="pk-bolt" />}{name}
              </button>
            ))}
          </div>
          <div class="pk-panels">
            {f.gaming.profileList.map(([name, desc, n], i) => (
              <div class="pk-panel" role="tabpanel" id={`pk-panel-${i}`} aria-labelledby={`pk-tab-${i}`} hidden={i !== 0}>
                <h4>{name}</h4>
                <p>{desc}</p>
                <div class="pk-count">
                  <span class="pk-bars" aria-hidden="true">{Array.from({ length: maxChanges }, (_, k) => <i class:list={[k < n && "on"]}></i>)}</span>
                  <span class="mono">{f.gaming.changes(n)}</span>
                </div>
              </div>
            ))}
          </div>
          <blockquote class="quote">
            <p>{lang === "fr" ? `« ${f.gaming.quote} »` : `“${f.gaming.quote}”`}</p>
            <footer class="mono">{f.gaming.quoteBy}</footer>
          </blockquote>
        </div>
      </div>
    </article>

    <!-- Monitoring: an instrument strip (illustration), then the real monitor. -->
    <article class="chapter ch-monitor" aria-labelledby="ch-monitor">
      <div class="wrap">
        <div class="split-head reveal">
          <div>
            <p class="ch-label"><span class="ch-idx mono">{f.monitor.idx}</span>{f.monitor.label}</p>
            <h3 id="ch-monitor">{f.monitor.title}</h3>
          </div>
          <p class="ch-text">{f.monitor.text}</p>
        </div>
        <figure class="instruments" data-live>
          <ul data-stagger>
            {meters.map((m, i) => (
              <li class={`m-${i}`}>
                <span class="m-k mono">{m.k}</span>
                <svg class="m-wave" viewBox="0 0 200 56" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <g class="m-slide">
                    <path class="m-fill" d={`${m.path} L400,56 L0,56 Z`} />
                    <path class="m-line" d={m.path} />
                  </g>
                </svg>
                <span class="m-d">{m.d}</span>
              </li>
            ))}
          </ul>
          <figcaption class="mono"><span class="illus-tag">Illustration</span>{f.monitor.illus}</figcaption>
        </figure>
        <figure class="panel monitor-panel reveal" data-anim="scan">
          <Shot lang={lang} name="monitor" alt={f.monitor.alt} sizes="(min-width: 1240px) 1200px, 94vw" widths={[640, 960, 1286]} />
          <span class="scanline" aria-hidden="true"></span>
        </figure>
        <p class="footnote reveal"><Icon name="alert" />{f.monitor.note}</p>
        <div class="monitor-more">
          <div class="note glass spot reveal">
            <h4><Icon name="gauge" />{f.monitor.bench}</h4>
            <p>{f.monitor.benchText}</p>
          </div>
          <div class="note glass spot net-note reveal" data-delay="1">
            <h4><Icon name="network" />{f.monitor.net}</h4>
            <p>{f.monitor.netText}</p>
            <figure class="net-shot">
              <Shot lang={lang} name="network" alt={f.monitor.netAlt} sizes="(min-width: 1000px) 520px, 90vw" widths={[330, 660]} />
            </figure>
          </div>
        </div>
      </div>
    </article>

    <!-- Debloat: the classification, drawn as four lanes. -->
    <article class="chapter ch-debloat" aria-labelledby="ch-debloat">
      <div class="wrap">
        <div class="ch-copy narrow reveal">
          <p class="ch-label"><span class="ch-idx mono">{f.debloat.idx}</span>{f.debloat.label}</p>
          <h3 id="ch-debloat">{f.debloat.title}</h3>
          <p class="ch-text">{f.debloat.text}</p>
        </div>
        <div class="sorter reveal" data-anim="sort">
          <p class="src mono"><Icon name="layers" />{f.debloat.capture}</p>
          <svg class="branches" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            {[50, 150, 250, 350].map((x) => <path d={`M200 0 C200 34 ${x} 26 ${x} 60`} pathLength="1" />)}
          </svg>
          <ol class="lanes">
            {f.debloat.tiers.map(([name, text], i) => (
              <li class={tierClass[i]} style={`--i:${i}`}>
                <p class="ln-head"><span class="tier-dot" aria-hidden="true"></span>{name}</p>
                <p class="ln-count mono">{f.debloat.counts[i] ?? <><Icon name="lock" />{f.debloat.locked}</>}</p>
                <p class="ln-text">{text}</p>
                <ul class="ln-ex">{f.debloat.examples[i].map((x) => <li>{x}</li>)}</ul>
              </li>
            ))}
          </ol>
        </div>
        <figure class="panel debloat-shot reveal" data-parallax="0.03">
          <Shot lang={lang} name="debloat" alt={f.debloat.alt} sizes="(min-width: 1240px) 1100px, 94vw" />
        </figure>
        <div class="pair">
          <div class="reveal"><h4><Icon name="bolt" />{f.debloat.startup}</h4><p>{f.debloat.startupText}</p></div>
          <div class="reveal" data-delay="1"><h4><Icon name="eye" />{f.debloat.privacy}</h4><p>{f.debloat.privacyText}</p></div>
        </div>
      </div>
    </article>

    <!-- Storage: what was found, to scale. -->
    <article class="chapter ch-storage" aria-labelledby="ch-storage">
      <div class="wrap ch-grid reverse">
        <div class="ch-copy reveal">
          <p class="ch-label"><span class="ch-idx mono">{f.storage.idx}</span>{f.storage.label}</p>
          <h3 id="ch-storage">{f.storage.title}</h3>
          <p class="ch-text">{f.storage.text}</p>
          <ul class="ticks">
            {f.storage.points.map((p) => <li><Icon name="check" />{p}</li>)}
          </ul>
          <p class="never-title mono">{f.storage.never}</p>
          <ul class="never">
            {f.storage.neverList.map((p) => <li><Icon name="lock" />{p}</li>)}
          </ul>
        </div>
        <div class="ch-visual storage-visual">
          <figure class="panel tilt-r st-shot reveal" data-delay="1">
            <Shot lang={lang} name="storage" alt={f.storage.alt} sizes="(min-width: 1000px) 58vw, 94vw" />
          </figure>
          <div class="volume glass glass-3 reveal" data-delay="2" data-anim="fill" data-parallax="-0.05">
            <p class="vol-total"><span class="vol-n">{f.storage.found}</span><span class="vol-t">{f.storage.foundText}</span></p>
            <div class="vol-bar" aria-hidden="true">
              {f.storage.segments.map(([, , , n, c], i) => <span class={c} style={`--w:${((n / segTotal) * 100).toFixed(2)}; --i:${i}`}></span>)}
            </div>
            <dl class="vol-legend">
              {f.storage.segments.map(([name, sub, val, , c]) => (
                <div class={c}><dt><span class="sw-dot"></span>{name}<small>{sub}</small></dt><dd class="mono">{val}</dd></div>
              ))}
            </dl>
            <p class="vol-note">{f.storage.vizNote}</p>
          </div>
        </div>
      </div>
    </article>

    <!-- Repair: Windows' own tools, in a terminal that steps through them. -->
    <article class="chapter ch-repair" aria-labelledby="ch-repair">
      <div class="wrap ch-grid">
        <div class="ch-copy reveal">
          <p class="ch-label"><span class="ch-idx mono">{f.repair.idx}</span>{f.repair.label}</p>
          <h3 id="ch-repair">{f.repair.title}</h3>
          <p class="ch-text">{f.repair.text}</p>
          <ul class="ticks">
            {f.repair.points.map((p) => <li><Icon name="check" />{p}</li>)}
          </ul>
        </div>
        <div class="ch-visual repair-visual">
          <figure class="panel repair-shot reveal" data-parallax="0.05">
            <Shot lang={lang} name="repair" alt={f.repair.alt} sizes="(min-width: 1000px) 50vw, 94vw" />
          </figure>
          <div class="terminal glass glass-3 reveal" data-delay="2" data-parallax="-0.05" data-live data-cycle>
            <div class="term-bar"><span class="tb-dots" aria-hidden="true"><i></i><i></i><i></i></span><Icon name="pulse" /><span class="mono">Windows Ultimate · {f.repair.label}</span></div>
            <ol class="term-lines" data-stagger>
              {f.repair.cmds.map(([cmd, kind, dur]) => (
                <li>
                  <code><span class="prompt">›</span>{cmd}</code>
                  <span class="term-meta">
                    {kind.split(" ").map((k) => <span class={`tag ${tagClass[k]}`}>{tags[k]}</span>)}
                    <span class="dur mono">{dur}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </article>

    <div class="wrap">
      <div class="more reveal">
        <p class="mono more-title">{f.more}</p>
        <ul data-stagger>
          {f.moreItems.map((m, i) => <li><Icon name={moreIcons[i]} />{m}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────── Tour ───────── -->
  <section id="tour" class="tour" aria-labelledby="tour-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">03</span> {f.tour.eyebrow}</p>
        <h2 id="tour-title">{f.tour.title}</h2>
        <p>{f.tour.lead}</p>
      </div>
      <div class="tour-ui reveal" data-tour>
        <div class="tour-tabs" role="tablist" aria-label={f.tour.title}>
          {tour.map(([key, label], i) => (
            <button type="button" role="tab" id={`tour-tab-${key}`} aria-controls={`tour-${key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              <span class="tt-n mono">{pad(i + 1)}</span>{label}
            </button>
          ))}
          <span class="tour-ink" aria-hidden="true"></span>
        </div>
        <div class="tour-stage">
          <div class="tour-glow" aria-hidden="true"></div>
          <div class="tour-frame">
            {tour.map(([key, label, text], i) => (
              <figure class="tour-panel" role="tabpanel" id={`tour-${key}`} aria-labelledby={`tour-tab-${key}`} hidden={i !== 0}>
                <Shot lang={lang} name={tourShot(key)} alt={`${label}: ${text}`} sizes="(min-width: 1240px) 1200px, 94vw" widths={[800, 1200, 1600]} />
                <figcaption><span class="mono">{pad(i + 1)} / {pad(tour.length)}</span>{text}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Technology ───────── -->
  <section id="technology" class="tech" aria-labelledby="tech-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">04</span> {t.tech.eyebrow}</p>
        <h2 id="tech-title">{t.tech.title}</h2>
        <p>{t.tech.lead}</p>
      </div>

      <div class="flow reveal" data-flow data-live data-anim="flow" style="--k: 0">
        <div class="flow-rail">
          <span class="flow-track" aria-hidden="true"><span class="flow-fill"></span><span class="flow-pulse"></span></span>
          <ol class="flow-steps" role="tablist" aria-label={t.tech.title}>
            {t.tech.steps.map(([name], i) => (
              <li role="presentation">
                <button type="button" role="tab" id={`flow-tab-${i}`} aria-controls={`flow-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} style={`--i:${i}`}>
                  <span class="fn mono">{pad(i + 1)}</span>
                  <span class="fl">{name}</span>
                </button>
              </li>
            ))}
          </ol>
          <p class="flow-fail mono" aria-hidden="true"><span class="ff-arc"></span><span class="ff-label"><Icon name="undo" />{t.tech.fail}</span></p>
        </div>
        <div class="flow-panels glass glass-3">
          {t.tech.steps.map(([name, text], i) => (
            <div class="flow-panel" role="tabpanel" id={`flow-panel-${i}`} aria-labelledby={`flow-tab-${i}`}>
              <p class="fp-step mono">{t.tech.stepOf(i + 1, t.tech.steps.length)}</p>
              <h3>{name}</h3>
              <p>{text}</p>
            </div>
          ))}
          <span class="fp-progress" aria-hidden="true"></span>
        </div>
      </div>

      <div class="tech-grid">
        <div class="risk glass spot reveal">
          <h3>{t.tech.risk}</h3>
          <p>{t.tech.riskText}</p>
          <ol class="levels">
            {t.tech.levels.map((l, i) => <li class={levelClass[i]}><span class="bar"></span><span class="mono">{l}</span></li>)}
          </ol>
          <figure class="risk-shot">
            <Shot lang={lang} name="responsiveness" alt={t.tech.riskAlt} sizes="(min-width: 1000px) 520px, 90vw" widths={[640, 960, 1298]} />
          </figure>
        </div>
        <div class="history reveal" data-delay="1">
          <h3>{t.tech.historyTitle}</h3>
          <p>{t.tech.historyText}</p>
          <figure class="panel">
            <Shot lang={lang} name="history" alt={t.tech.historyAlt} sizes="(min-width: 1000px) 640px, 94vw" widths={[640, 960, 1298]} />
          </figure>
          <div class="details">
            <p class="details-title mono">{t.tech.detailsTitle}</p>
            {t.tech.details.map(([q, a]) => (
              <details>
                <summary>{q}<span class="sum-ico" aria-hidden="true"></span></summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Trust ───────── -->
  <section id="trust" class="trust" aria-labelledby="trust-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">05</span> {t.trust.eyebrow}</p>
        <h2 id="trust-title">{t.trust.title}</h2>
        <p>{t.trust.lead}</p>
      </div>

      <ol class="ledger" data-stagger>
        {t.trust.principles.map(([name, text], i) => (
          <li>
            <span class="lg-n mono">{pad(i + 1)}</span>
            <span class="lg-icon"><Icon name={(["eye", "undo", "shield", "lock", "lock", "gauge"] as const)[i]} /></span>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>

      <div class="perm reveal">
        <div class="perm-head">
          <h3>{t.trust.permTitle}</h3>
          <p>{t.trust.permLead}</p>
        </div>
        <div class="perm-levels">
          <div class="pl pl-user glass spot">
            <p class="pl-title"><span class="led"></span>{t.trust.user}</p>
            <ul>{t.trust.userList.map((x) => <li><Icon name="check" />{x}</li>)}</ul>
          </div>
          <div class="pl pl-admin glass spot">
            <p class="pl-title"><span class="led"></span>{t.trust.admin}</p>
            <ul>{t.trust.adminList.map((x) => <li><Icon name="key" />{x}</li>)}</ul>
            <p class="pl-note mono">{t.trust.adminNote}</p>
          </div>
          <div class="pl pl-confirm glass spot">
            <p class="pl-title"><span class="led"></span>{t.trust.confirm}</p>
            <ul>{t.trust.confirmList.map((x) => <li><Icon name="alert" />{x}</li>)}</ul>
            <div class="confirm-steps" aria-hidden="true"><span>1</span><i></i><span>2</span></div>
          </div>
        </div>
      </div>

      <div class="limits reveal">
        <h3 class="mono">{t.trust.limitsTitle}</h3>
        <ul>{t.trust.limits.map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ───────── Download ───────── -->
  <section id="download" class="download" aria-labelledby="download-title">
    <div class="wrap">
      <div class="dl">
        <div class="dl-card glass glass-3 reveal">
          <div class="dl-beam" aria-hidden="true"></div>
          <div class="dl-mark" aria-hidden="true">
            <span class="hm-halo"></span>
            <svg class="dl-rings" viewBox="0 0 200 200"><circle cx="100" cy="100" r="60" /><circle cx="100" cy="100" r="78" /><circle cx="100" cy="100" r="96" /></svg>
            <Logo id="dl" />
          </div>
          <p class="eyebrow">{t.download.eyebrow}</p>
          <h2 id="download-title">{t.download.title}</h2>
          <p class="dl-lead">{t.download.lead}</p>
          <div class="dl-file">
            <span class="df-icon" aria-hidden="true"><Icon name="download" /></span>
            <span class="df-name mono" data-r="name">{release.asset.name}</span>
            <span class="df-size mono" data-r="size">{size}</span>
          </div>
          <a class="btn btn-primary btn-lg dl-btn" href={release.asset.url} data-r="href:asset">
            <Icon name="download" class="arrow" />{t.download.button}
          </a>
          <p class="dl-sub mono">Windows Ultimate <span data-r="version">{v}</span> · <time datetime={release.publishedAt} data-r="date">{formatDate(release.publishedAt, lang)}</time></p>
          <div class="dl-links">
            <a href={release.url} data-r="href:url"><Icon name="notes" />{t.download.notes}</a>
            <a href={RELEASES_URL}><Icon name="history" />{t.download.all}</a>
            <a href={GITHUB_URL}><Icon name="github" />{t.download.source}</a>
          </div>
        </div>

        <ol class="dl-steps">
          {t.download.steps.map(([name, text], i) => (
            <li class="reveal" data-delay={String(i + 1)}>
              <span class="ds-n mono" aria-hidden="true">{pad(i + 1)}</span>
              <div class="ds-body">
                <h3>{name}</h3>
                <p>{text}</p>
                {i === 1 && (
                  <div class="hash-box">
                    <p class="hash-title mono">{t.download.hashTitle}</p>
                    {hash ? (
                      <>
                        <div class="hash-row">
                          <code id="sha" class="hash" data-r="hash">{hash}</code>
                          <button class="btn btn-glass btn-sm copy" type="button" data-copy="#sha" data-copied={t.download.copied} data-fail={t.download.copyFail}>
                            <Icon name="copy" /><span class="copy-label">{t.download.copy}</span>
                          </button>
                        </div>
                        <p class="hash-help">{t.download.hashText}</p>
                        <code class="cmd">Get-FileHash .\<span data-r="name">{release.asset.name}</span> -Algorithm SHA256</code>
                      </>
                    ) : (
                      <p class="hash-help">{t.download.noHash}</p>
                    )}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>

      <dl class="facts reveal">
        <div><dt>{t.download.system}</dt><dd>{t.download.systemText}</dd></div>
        <div><dt>{t.download.install}</dt><dd>{t.download.installText}</dd></div>
        <div><dt>{t.download.updates}</dt><dd>{t.download.updatesText}</dd></div>
      </dl>
      <div class="dl-notes">
        <p class="reveal"><Icon name="shield" />{t.download.smartscreen}</p>
        <p class="reveal" data-delay="1"><Icon name="undo" />{t.download.uninstall}</p>
      </div>
    </div>
  </section>

  <!-- ───────── Closing ───────── -->
  <section class="final" aria-labelledby="final-title">
    <div class="final-light" aria-hidden="true"></div>
    <div class="wrap final-inner reveal">
      <div class="final-mark" aria-hidden="true"><Logo id="fin" /></div>
      <h2 id="final-title">{t.final.title}</h2>
      <p>{t.final.text}</p>
      <div class="cta">
        <a class="btn btn-primary btn-lg" href="#download"><Icon name="download" class="arrow" />{t.hero.download}</a>
        <a class="btn btn-glass btn-lg" href={GITHUB_URL}><Icon name="github" />GitHub</a>
      </div>
    </div>
  </section>

  <ReleaseSync lang={lang} />
</Base>

<style>
  /* ───────── Hero ───────── */
  .hero { padding-block: clamp(36px, 6vw, 80px) clamp(70px, 9vw, 130px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 500px) minmax(0, 1fr); gap: clamp(32px, 4vw, 60px); align-items: center; }
  .hero-copy { position: relative; z-index: 3; display: grid; justify-items: start; }
  h1 { font-size: clamp(2.5rem, 4.9vw, 4.25rem); line-height: 1.02; letter-spacing: -0.045em; margin-block: 22px 24px; }
  .h1-a, .h1-b { display: block; }
  /* The French line is longer: a step smaller keeps the buttons in the first screen. */
  :global(html[lang="fr"]) h1 { font-size: clamp(2.3rem, 4.1vw, 3.6rem); }
  .lead { color: var(--text-2); font-size: clamp(1.05rem, 1.35vw, 1.2rem); max-width: 44ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hero-meta { margin-top: 22px; color: var(--text-3); font-size: 12.5px; letter-spacing: 0.01em; }

  /* The animated mark: the tile lands, the W is traced, an orbit closes around it, light crosses the glass. */
  .hero-mark { position: relative; width: 60px; height: 60px; margin-bottom: 26px; }
  .hero-mark :global(.hm-logo) { position: relative; width: 60px; height: 60px; filter: drop-shadow(0 12px 28px rgb(61 139 255 / 0.45)); }
  .hm-halo { position: absolute; inset: -40px; border-radius: 50%; background: radial-gradient(closest-side, rgb(61 139 255 / 0.35), transparent); filter: blur(6px); }
  .hm-orbit { position: absolute; inset: -14px; width: calc(100% + 28px); height: calc(100% + 28px); overflow: visible; }
  .hm-orbit { transform-origin: 50% 50%; }
  .hm-orbit circle { fill: none; stroke: rgb(125 180 255 / 0.35); stroke-width: 0.8; stroke-dasharray: 0.12 0.03; }
  .hm-sheen { position: absolute; inset: 0; border-radius: 17px; overflow: hidden; pointer-events: none; }
  .hm-sheen::after { content: ""; position: absolute; inset: -20% auto -20% -60%; width: 40%; background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.5), transparent); transform: skewX(-18deg); opacity: 0; }
  :global(.js) .hero-mark :global(.m-tile) { transform-origin: 16px 16px; animation: tile-in 0.9s var(--ease-out) 0.1s both; }
  :global(.js) .hero-mark :global(.m-w) { stroke-dasharray: 1; stroke-dashoffset: 1; animation: trace 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.45s forwards; }
  :global(.js) .hm-halo { animation: halo 2.2s var(--ease) 0.3s both; }
  :global(.js) .hm-orbit { animation: orbit 1.6s var(--ease-out) 0.6s both; }
  :global(.js) .hm-sheen::after { animation: sheen 1.1s var(--ease) 1.5s; }
  @keyframes tile-in { from { opacity: 0; transform: scale(0.6) rotate(-8deg); } }
  @keyframes trace { to { stroke-dashoffset: 0; } }
  @keyframes halo { 0% { opacity: 0; transform: scale(0.6); } 45% { opacity: 1; } 100% { opacity: 0.55; transform: none; } }
  @keyframes orbit { from { opacity: 0; transform: rotate(-120deg) scale(0.7); } }
  @keyframes sheen { 0% { opacity: 1; left: -60%; } 100% { opacity: 1; left: 130%; } }

  /* Intro: the copy comes in after the mark, the window last. */
  :global(.js) .hero-eyebrow, :global(.js) .hero-lead, :global(.js) .hero-cta, :global(.js) .hero-meta { animation: rise 1s var(--ease-out) both; }
  :global(.js) .hero-eyebrow { animation-delay: 0.55s; }
  :global(.js) h1 { --d: 0.7s; }
  :global(.js) .hero-lead { animation-delay: 1.05s; }
  :global(.js) .hero-cta { animation-delay: 1.18s; }
  :global(.js) .hero-meta { animation-delay: 1.3s; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); filter: blur(4px); } }
  :global(.js) h1 :global(.w:has(.glow-text)) { transition-delay: 1.05s; }

  /* The stage: the real window in space, a glass slab behind it, close-ups of the interface in front.
     --p (scroll) straightens the window; --mx/--my (pointer) shift each layer by its depth --d. */
  .hero-stage { --p: 0; --mx: 0; --my: 0; position: relative; margin-right: calc(-1 * clamp(40px, 12vw, 220px)); perspective: 2200px; padding-block: 30px 60px; }
  .stage-glow {
    position: absolute; inset: -12% -6% -18% -10%; z-index: -1;
    background:
      radial-gradient(45% 50% at 42% 45%, rgb(61 139 255 / 0.3), transparent 70%),
      radial-gradient(40% 40% at 80% 75%, rgb(138 114 240 / 0.22), transparent 70%);
    filter: blur(20px);
  }
  .gauge {
    position: absolute; left: 50%; top: 46%; width: 128%; aspect-ratio: 1; translate: -50% -50%; z-index: -1;
    -webkit-mask-image: radial-gradient(closest-side, #000 60%, transparent);
    mask-image: radial-gradient(closest-side, #000 60%, transparent);
    opacity: 0.9;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gauge { animation: spin 160s linear infinite; animation-play-state: paused; }
    .live .gauge { animation-play-state: running; }
    @keyframes spin { to { rotate: 360deg; } }
  }
  /* A sheet of frosted glass behind the window: the second plane of depth. */
  .slab {
    position: absolute; left: 10%; right: -4%; top: 0; bottom: 22%; border-radius: var(--r-xl);
    background: linear-gradient(160deg, rgb(125 180 255 / 0.1), rgb(138 114 240 / 0.05) 60%, rgb(255 255 255 / 0.02));
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.07) inset, 0 1px 0 rgb(255 255 255 / 0.12) inset;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    transform: rotateY(calc(-22deg * (1 - var(--p)))) translateZ(-160px);
    translate: calc(var(--mx) * -6px) calc(var(--my) * -6px);
  }
  :global(.js) .slab { animation: fade-in 1.4s var(--ease) 0.4s both; }
  @keyframes fade-in { from { opacity: 0; } }
  .window {
    position: relative; margin: 0; transform-style: preserve-3d;
    transform: rotateY(calc(-17deg * (1 - var(--p)) + var(--mx) * 2.5deg)) rotateX(calc(7deg * (1 - var(--p)) - var(--my) * 2deg)) translateZ(0);
    transform-origin: 0% 50%;
    will-change: transform;
  }
  :global(.js) .window { animation: window-in 1.6s var(--ease-out) 0.55s both; }
  @keyframes window-in { from { opacity: 0; translate: 60px 40px; filter: blur(10px); } }
  .window-frame {
    position: relative; overflow: hidden; border-radius: 14px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 60px 120px -30px rgb(0 0 0 / 0.85),
      0 30px 80px -40px rgb(61 139 255 / 0.55);
  }
  .window-frame::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.35), rgb(255 255 255 / 0.06) 18%, rgb(255 255 255 / 0.04));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  }
  .window-frame :global(img) { width: 100%; }
  .window-sheen {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 32%, rgb(255 255 255 / 0.07) 42%, rgb(255 255 255 / 0.015) 52%, transparent 60%);
    transform: translateX(calc(-18% * var(--p) + var(--mx) * 3%));
  }
  /* One pass of light down the window as it lands, like a scan. */
  .window-scan { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent, rgb(125 180 255 / 0.16) 48%, rgb(125 180 255 / 0.4) 50%, transparent 51%); transform: translateY(-100%); opacity: 0; }
  :global(.js) .window-scan { animation: wscan 1.8s cubic-bezier(0.45, 0, 0.25, 1) 1.6s; }
  @keyframes wscan { 0% { opacity: 1; transform: translateY(-60%); } 85% { opacity: 1; } 100% { opacity: 0; transform: translateY(60%); } }
  .window figcaption { margin-top: 18px; color: var(--text-3); font-size: 12px; text-align: right; padding-right: clamp(40px, 12vw, 220px); }

  /* Close-ups of the real interface, floating in front of the window. */
  .float { position: absolute; z-index: 2; margin: 0; translate: calc(var(--mx) * var(--d) * 1px) calc(var(--my) * var(--d) * 1px); }
  .f-health, .f-recs {
    overflow: hidden; border-radius: 14px; background: #0b0f17;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14), 0 40px 80px -20px rgb(0 0 0 / 0.9), 0 0 60px -20px rgb(61 139 255 / 0.6);
  }
  .f-health::after, .f-recs::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.14), transparent 30%);
  }
  .float :global(img) { width: 100%; }
  .f-health { left: -9%; bottom: 4%; width: 23%; }
  .f-recs { right: 2%; bottom: 17%; width: 54%; border-radius: 12px; }
  .chip {
    display: inline-flex; align-items: center; gap: 9px; padding: 9px 14px; border-radius: 999px;
    font: 500 12px/1.2 var(--mono); color: var(--text); white-space: nowrap;
    background: rgb(12 17 27 / 0.78); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12) inset, 0 16px 34px -14px rgb(0 0 0 / 0.8);
  }
  .c-user { right: 10%; top: 2%; }
  .chip .led { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px rgb(52 211 153 / 0.2), 0 0 10px var(--success); }
  @media (prefers-reduced-motion: no-preference) {
    .live .chip .led { animation: blink 2.4s var(--ease) infinite; }
    @keyframes blink { 50% { box-shadow: 0 0 0 6px rgb(52 211 153 / 0), 0 0 14px var(--success); } }
  }
  :global(.js) .f-health { animation: float-in 1.2s var(--ease-out) 1.35s both; }
  :global(.js) .f-recs { animation: float-in 1.2s var(--ease-out) 1.55s both; }
  :global(.js) .c-user { animation: float-in 1s var(--ease-out) 1.9s both; }
  @keyframes float-in { from { opacity: 0; transform: translateY(26px) scale(0.96); filter: blur(8px); } }
  /* Light pooling on the floor under the window. */
  .floor { position: absolute; left: 4%; right: 8%; bottom: 0; height: 90px; z-index: -1; background: radial-gradient(50% 50% at 50% 50%, rgb(61 139 255 / 0.35), transparent 70%); filter: blur(18px); }

  @media (max-width: 1099px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { max-width: 640px; }
    .hero-stage { margin-right: 0; margin-top: 8px; padding-bottom: 20px; }
    .window { transform: rotateX(calc(16deg * (1 - var(--p)))) scale(calc(0.94 + 0.06 * var(--p))); transform-origin: 50% 100%; }
    .slab { left: 6%; right: 6%; top: 4px; bottom: 34%; transform: none; }
    .window figcaption { padding-right: 0; }
    .gauge { width: 110%; }
    .f-health { left: -1%; bottom: 22%; width: 24%; }
    .f-recs { right: -1%; bottom: 22%; width: 58%; }
  }
  @media (max-width: 640px) {
    .window-frame { border-radius: 10px; }
    .window figcaption { text-align: left; }
    .cta .btn { flex: 1 1 100%; }
    .hero-stage { padding-block: 44px 30px; }
    .slab { display: none; }
    .f-health { width: 30%; left: auto; right: 2%; top: 0; bottom: auto; }
    .f-recs, .c-user { display: none; }
    .hero-mark { width: 54px; height: 54px; }
    .hero-mark :global(.hm-logo) { width: 54px; height: 54px; }
  }

  /* ───────── The problem ───────── */
  .problem { padding-top: clamp(80px, 10vw, 140px); }
  .statement { margin-top: 28px; max-width: 24ch; font-size: clamp(1.9rem, 4.4vw, 3.5rem); font-weight: 600; line-height: 1.12; letter-spacing: -0.035em; }
  .statement :global(.sw) { color: rgb(201 209 221 / 0.2); transition: color 0.5s var(--ease); }
  .statement :global(.sw.on) { color: var(--text); }

  .versus { display: grid; grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr); align-items: center; gap: 16px; margin-top: clamp(56px, 8vw, 100px); }
  .vs { padding: clamp(24px, 3vw, 36px); border-radius: var(--r-lg); }
  .vs-usual { background: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.015) 0 10px, transparent 10px 20px); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06) inset; }
  .vs-title { display: flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); }
  .vs-ours .vs-title { color: var(--accent-bright); }
  .vs-ours :global(.vs-mark) { width: 22px; height: 22px; }
  .vs ul { display: grid; gap: 4px; margin-top: 20px; }
  .vs li { display: grid; grid-template-columns: 22px 1fr; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); font-size: 15.5px; }
  .vs li :global(.icon) { width: 18px; height: 18px; margin-top: 3px; }
  .vs-usual li { color: var(--text-3); }
  .vs-usual li :global(.icon) { color: var(--danger); opacity: 0.8; }
  .vs-ours li { color: var(--text); }
  .vs-ours li :global(.icon) { color: var(--success); }
  /* Each usual promise is struck through as the block arrives. */
  .vs-usual li span { background: linear-gradient(rgb(240 96 90 / 0.55), rgb(240 96 90 / 0.55)) 0 58% / 0% 1.5px no-repeat; transition: background-size 0.7s var(--ease) calc(0.5s + var(--i) * 0.15s); }
  :global(.js) .vs-usual.in li span, :global(html:not(.js)) .vs-usual li span { background-size: 100% 1.5px; }
  .vs-arrow { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; color: var(--accent-bright); background: var(--accent-soft); box-shadow: 0 0 0 1px rgb(125 180 255 / 0.25) inset, 0 0 40px -6px rgb(61 139 255 / 0.6); }
  .vs-arrow :global(.icon) { width: 22px; height: 22px; }
  @media (max-width: 860px) {
    .versus { grid-template-columns: 1fr; justify-items: stretch; }
    .vs-arrow { justify-self: center; rotate: 90deg; }
  }

  .myths { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 72px); margin-top: clamp(64px, 9vw, 120px); align-items: start; }
  .myths h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -0.025em; }
  .myths p { color: var(--text-2); margin-top: 10px; max-width: 60ch; }
  .myths ul { display: flex; flex-wrap: wrap; gap: 8px; }
  .myths li {
    padding: 9px 13px; border-radius: var(--r-sm); font-size: 14px; color: var(--text-3);
    background: rgb(255 255 255 / 0.025); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.07) inset;
    transition: color 0.3s, box-shadow 0.3s;
  }
  .myths s { text-decoration-color: rgb(240 96 90 / 0.7); text-decoration-thickness: 1.5px; }
  .myths li:hover { color: var(--text-2); box-shadow: 0 0 0 1px rgb(240 96 90 / 0.35) inset; }
  @media (max-width: 860px) { .myths { grid-template-columns: 1fr; } }

  .cover { margin-top: clamp(64px, 9vw, 120px); }
  .cover-title { color: var(--text-3); font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; }
  .cover-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 18px; border-radius: var(--r-lg); overflow: hidden; background: rgb(10 14 22 / 0.5); box-shadow: 0 0 0 1px var(--line) inset; }
  .cover-grid li { position: relative; isolation: isolate; display: grid; grid-template-columns: 40px 1fr; gap: 14px; padding: 22px 20px; box-shadow: 1px 0 0 var(--line), 0 1px 0 var(--line); }
  .cv-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--r-sm); color: var(--accent-bright); background: var(--metal); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08) inset; transition: color 0.3s, box-shadow 0.3s; }
  .cv-icon :global(.icon) { width: 20px; height: 20px; }
  .cover-grid li:hover .cv-icon { color: #fff; box-shadow: 0 0 0 1px rgb(125 180 255 / 0.4) inset, 0 0 20px -4px var(--accent); }
  .cover-grid h3 { font-size: 1rem; letter-spacing: -0.01em; margin-top: 2px; }
  .cover-grid p { color: var(--text-2); font-size: 14px; line-height: 1.5; margin-top: 6px; }
  @media (max-width: 1000px) { .cover-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cover-grid { grid-template-columns: 1fr; } }

  /* ───────── Features ───────── */
  .features { padding-bottom: clamp(60px, 8vw, 100px); }
  .chapter { padding-block: clamp(56px, 8vw, 110px); }
  .chapter + .chapter { border-top: 1px solid transparent; border-image: linear-gradient(90deg, transparent, var(--line-strong), transparent) 1; }
  .ch-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(36px, 5vw, 80px); align-items: center; }
  .ch-grid.reverse { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .ch-grid.reverse .ch-copy { order: 2; }
  .ch-label { display: flex; align-items: center; gap: 12px; color: var(--accent-bright); font: 500 12.5px/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .ch-idx {
    display: inline-grid; place-items: center; width: 34px; height: 24px; border-radius: var(--r-xs); font-size: 11.5px; letter-spacing: 0;
    color: var(--text); background: var(--accent-soft); box-shadow: 0 0 0 1px rgb(125 180 255 / 0.25) inset;
  }
  .chapter h3 { font-size: clamp(1.9rem, 3.6vw, 2.8rem); margin: 20px 0 18px; }
  .ch-text { color: var(--text-2); font-size: 1.06rem; max-width: 54ch; }
  .ticks { display: grid; gap: 12px; margin-top: 26px; }
  .ticks li { display: grid; grid-template-columns: 20px 1fr; gap: 12px; font-size: 15.5px; color: var(--silver); }
  .ticks :global(.icon) { width: 18px; height: 18px; margin-top: 3px; color: var(--success); }

  .panel {
    position: relative; margin: 0; overflow: hidden; border-radius: 14px; background: #0b0f17;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.09), 0 50px 100px -40px rgb(0 0 0 / 0.9), 0 20px 60px -30px rgb(61 139 255 / 0.35);
  }
  .panel::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; padding: 1px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0.05) 20%, transparent);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  }
  .panel :global(img) { width: 100%; }
  .ch-visual { position: relative; perspective: 1800px; }
  .tilt-r { transform: rotateY(7deg) rotateX(2deg); transform-origin: 100% 50%; transition: transform 1.2s var(--ease-out); }
  .ch-visual:hover .tilt-r { transform: none; }

  /* Gaming */
  .gaming-visual { display: grid; padding-bottom: 18%; }
  .g-profiles { transform: rotateY(-6deg) rotateX(2deg); transform-origin: 0 50%; transition: transform 1.2s var(--ease-out); }
  .gaming-visual:hover .g-profiles { transform: none; }
  .g-analysis { position: absolute; left: -8%; bottom: 0; width: 52%; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14), 0 40px 80px -20px rgb(0 0 0 / 0.95), 0 0 50px -20px rgb(61 139 255 / 0.5); }
  .picker { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 20px 40px; margin-top: clamp(48px, 6vw, 80px); padding: clamp(22px, 3vw, 36px); border-radius: var(--r-lg); }
  .pk-head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 24px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .pk-title { font-weight: 640; font-size: 1.15rem; letter-spacing: -0.015em; }
  .pk-hint { color: var(--text-3); font-size: 14px; }
  .pk-list { display: grid; gap: 4px; align-content: start; }
  .pk-list button {
    display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 14px; border: 0; border-radius: var(--r-sm);
    font: 500 15px/1.3 var(--font); color: var(--text-2); text-align: left; cursor: pointer; background: transparent;
    transition: color 0.2s, background-color 0.25s, box-shadow 0.25s;
  }
  .pk-list button:hover { color: var(--text); background: rgb(255 255 255 / 0.04); }
  .pk-list button[aria-selected="true"] { color: var(--text); background: rgb(61 139 255 / 0.13); box-shadow: 0 0 0 1px rgb(125 180 255 / 0.28) inset; }
  .pk-dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: rgb(255 255 255 / 0.2); transition: background-color 0.25s, box-shadow 0.25s; }
  [aria-selected="true"] .pk-dot { background: var(--accent-bright); box-shadow: 0 0 10px var(--accent); }
  .pk-list :global(.pk-bolt) { width: 16px; height: 16px; color: var(--violet); margin: 0 -4px 0 -2px; }
  .pk-panels { display: grid; align-content: start; }
  .pk-panel { grid-area: 1 / 1; padding: 6px 0; }
  .pk-panel:not([hidden]) { animation: panel-in 0.5s var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px); } }
  .pk-panel h4 { font-size: 1.4rem; letter-spacing: -0.02em; }
  .pk-panel p { color: var(--text-2); margin-top: 12px; max-width: 58ch; }
  .pk-count { display: flex; align-items: center; gap: 14px; margin-top: 22px; color: var(--text-3); font-size: 13px; }
  .pk-bars { display: flex; gap: 4px; }
  .pk-bars i { width: 18px; height: 6px; border-radius: 3px; background: rgb(255 255 255 / 0.08); }
  .pk-bars i.on { background: linear-gradient(90deg, var(--accent-bright), var(--accent)); box-shadow: 0 0 10px rgb(61 139 255 / 0.6); }
  .quote { grid-column: 1 / -1; margin: 6px 0 0; padding: 18px 0 2px 20px; border-left: 2px solid; border-image: linear-gradient(var(--accent-bright), var(--violet)) 1; }
  .quote p { font-size: 1.08rem; color: var(--text); font-weight: 500; letter-spacing: -0.01em; }
  .quote footer { margin-top: 10px; color: var(--text-3); font-size: 12px; }
  @media (max-width: 860px) { .picker { grid-template-columns: 1fr; } }

  /* Monitoring */
  .split-head { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 80px); align-items: end; margin-bottom: clamp(36px, 5vw, 56px); }
  .split-head h3 { margin-bottom: 0; }
  .instruments { margin: 0 0 28px; }
  .instruments ul { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
  .instruments li {
    --c: var(--accent-bright);
    display: grid; gap: 10px; padding: 16px 16px 14px; border-radius: var(--radius);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.045), rgb(255 255 255 / 0.015)); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.07) inset, 0 1px 0 rgb(255 255 255 / 0.06) inset;
  }
  .instruments .m-1 { --c: var(--violet); }
  .instruments .m-2 { --c: var(--success); }
  .instruments .m-3 { --c: #6fd3ff; }
  .instruments .m-4 { --c: #a5b8ff; }
  .instruments .m-5 { --c: var(--warning); }
  .m-k { color: var(--c); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
  .m-wave { width: 100%; height: 48px; overflow: hidden; }
  .m-line { fill: none; stroke: var(--c); stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  .m-fill { fill: var(--c); opacity: 0.12; }
  .m-d { color: var(--text-2); font-size: 13.5px; line-height: 1.4; }
  @media (prefers-reduced-motion: no-preference) {
    .m-slide { animation: slide 7s linear infinite; animation-play-state: paused; }
    .live .m-slide { animation-play-state: running; }
    .m-1 .m-slide { animation-duration: 9s; }
    .m-2 .m-slide { animation-duration: 12s; }
    .m-3 .m-slide { animation-duration: 6s; }
    .m-4 .m-slide { animation-duration: 8s; }
    .m-5 .m-slide { animation-duration: 14s; }
    @keyframes slide { to { transform: translateX(-200px); } }
  }
  .instruments figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 12px; color: var(--text-3); font-size: 12px; }
  .illus-tag { padding: 3px 8px; border-radius: 6px; color: var(--text-2); background: rgb(255 255 255 / 0.06); text-transform: uppercase; letter-spacing: 0.08em; font-size: 10.5px; }
  .monitor-panel .scanline {
    position: absolute; top: 0; bottom: 0; left: 0; width: 18%; pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(125 180 255 / 0.14) 70%, rgb(125 180 255 / 0.5) 99%, transparent);
    opacity: 0; transform: translateX(-100%);
  }
  :global(.js) .monitor-panel.in .scanline { animation: scan 2.4s cubic-bezier(0.45, 0, 0.25, 1) 0.4s; }
  @keyframes scan { 0% { opacity: 1; transform: translateX(-100%); } 90% { opacity: 1; } 100% { opacity: 0; transform: translateX(560%); } }
  .footnote { display: flex; gap: 10px; margin-top: 26px; color: var(--text-3); font-size: 14px; max-width: 80ch; }
  .footnote :global(.icon) { width: 17px; height: 17px; flex: none; margin-top: 2px; color: var(--warning); }
  .monitor-more { display: grid; grid-template-columns: 1fr 1.25fr; gap: 20px; margin-top: 48px; align-items: start; }
  .note { padding: 28px; }
  .note h4 { display: flex; align-items: center; gap: 10px; font-size: 1.1rem; letter-spacing: -0.015em; }
  .note h4 :global(.icon) { width: 20px; height: 20px; color: var(--accent-bright); }
  .note p { color: var(--text-2); font-size: 15px; margin-top: 12px; }
  .net-shot { margin: 20px 0 0; border-radius: var(--r-sm); overflow: hidden; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08); }
  @media (max-width: 1100px) { .instruments ul { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 960px) { .split-head, .monitor-more { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .instruments ul { grid-template-columns: repeat(2, 1fr); } .m-d { font-size: 12.5px; } }

  /* Debloat: one source, four lanes. */
  .narrow { max-width: 760px; }
  .sorter { margin-top: clamp(40px, 5vw, 64px); }
  .src { display: flex; align-items: center; justify-content: center; gap: 10px; width: fit-content; margin-inline: auto; padding: 10px 16px; border-radius: 999px; font-size: 12.5px; color: var(--silver); background: var(--glass-3); box-shadow: 0 0 0 1px var(--line-strong) inset; }
  .src :global(.icon) { width: 16px; height: 16px; color: var(--accent-bright); }
  .branches { width: 100%; height: 56px; overflow: visible; }
  .branches path { fill: none; stroke: rgb(125 180 255 / 0.35); stroke-width: 1.2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(.js) .sorter .branches path { stroke-dashoffset: 1; transition: stroke-dashoffset 1.2s cubic-bezier(0.65, 0, 0.35, 1) 0.2s; }
  :global(.js) .sorter.in .branches path { stroke-dashoffset: 0; }
  .lanes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .lanes > li {
    --c: var(--success);
    position: relative; display: grid; align-content: start; gap: 10px; padding: 20px; border-radius: var(--radius);
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 10%, transparent), rgb(255 255 255 / 0.015) 55%);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 22%, transparent) inset;
  }
  .lanes > li::before { content: ""; position: absolute; left: 20px; right: 20px; top: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--c), transparent); opacity: 0.8; }
  .lanes .info { --c: var(--accent-bright); }
  .lanes .mod { --c: var(--warning); }
  .lanes .lock { --c: #8f9ab0; }
  :global(.js) .sorter .lanes > li { opacity: 0; transform: translateY(18px); transition: opacity 0.7s var(--ease), transform 0.9s var(--ease-out); transition-delay: calc(0.9s + var(--i) * 0.12s); }
  :global(.js) .sorter.in .lanes > li { opacity: 1; transform: none; }
  .ln-head { display: flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.01em; }
  .tier-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--c); box-shadow: 0 0 12px var(--c); }
  .ln-count { display: flex; align-items: center; gap: 8px; font-size: 2.2rem; font-weight: 500; line-height: 1; color: var(--c); letter-spacing: -0.04em; }
  .lock .ln-count { font-size: 14px; letter-spacing: 0.02em; text-transform: uppercase; }
  .ln-count :global(.icon) { width: 18px; height: 18px; }
  .ln-text { color: var(--text-2); font-size: 14px; line-height: 1.5; }
  .ln-ex { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .ln-ex li { padding: 4px 9px; border-radius: var(--r-xs); font-size: 12.5px; color: var(--silver); background: rgb(255 255 255 / 0.05); }
  .debloat-shot { margin-top: clamp(36px, 5vw, 56px); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); margin-top: clamp(40px, 5vw, 64px); }
  .pair h4 { display: flex; align-items: center; gap: 10px; font-size: 1.1rem; letter-spacing: -0.015em; }
  .pair h4 :global(.icon) { width: 19px; height: 19px; color: var(--accent-bright); }
  .pair p { color: var(--text-2); font-size: 15.5px; margin-top: 10px; }
  @media (max-width: 960px) { .lanes { grid-template-columns: repeat(2, 1fr); } .branches { display: none; } .src { margin-bottom: 18px; } .pair { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .lanes { grid-template-columns: 1fr; } }

  /* Storage: the found space, to scale. */
  .never-title { margin-top: 30px; color: var(--text-3); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; }
  .never { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .never li {
    display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px; border-radius: var(--r-sm);
    font-size: 13.5px; color: var(--silver); background: rgb(255 255 255 / 0.04); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08) inset;
  }
  .never :global(.icon) { width: 14px; height: 14px; color: var(--accent-bright); }
  .storage-visual { display: grid; padding-bottom: 30%; }
  .st-shot { opacity: 0.75; }
  .volume { position: absolute; right: -4%; bottom: 0; width: 76%; padding: 26px; border-radius: var(--r-lg); }
  .vol-total { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .vol-n { font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 640; letter-spacing: -0.04em; line-height: 1; color: transparent; background: var(--title); -webkit-background-clip: text; background-clip: text; }
  .vol-t { color: var(--text-2); font-size: 14px; }
  .vol-bar { display: flex; gap: 3px; height: 14px; margin-top: 20px; border-radius: 7px; overflow: hidden; background: rgb(255 255 255 / 0.04); }
  .vol-bar span { flex: var(--w) 1 0; min-width: 8px; border-radius: 3px; transform-origin: 0 50%; }
  .vol-bar .safe { background: linear-gradient(90deg, #2bb985, var(--success)); box-shadow: 0 0 14px rgb(52 211 153 / 0.6); }
  .vol-bar .mod { background: repeating-linear-gradient(135deg, rgb(245 184 61 / 0.75) 0 6px, rgb(245 184 61 / 0.5) 6px 12px); }
  :global(.js) .volume .vol-bar span { transform: scaleX(0); transition: transform 1.1s var(--ease-out) calc(0.5s + var(--i) * 0.2s); }
  :global(.js) .volume.in .vol-bar span { transform: none; }
  .vol-legend { display: grid; gap: 2px; margin-top: 18px; }
  .vol-legend div { --c: var(--warning); display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid var(--line); }
  .vol-legend .safe { --c: var(--success); }
  .vol-legend dt { display: grid; grid-template-columns: 16px 1fr; column-gap: 8px; font-size: 14px; color: var(--text); }
  .vol-legend small { grid-column: 2; color: var(--text-3); font-size: 12.5px; }
  .sw-dot { width: 9px; height: 9px; margin-top: 6px; border-radius: 3px; background: var(--c); }
  .vol-legend dd { color: var(--c); font-size: 13.5px; white-space: nowrap; }
  .vol-note { margin-top: 14px; color: var(--text-2); font-size: 13.5px; line-height: 1.55; }

  /* Repair */
  .repair-visual { display: grid; padding-block: 40px; }
  .repair-visual > * { grid-area: 1 / 1; }
  .repair-shot { width: 78%; justify-self: end; align-self: start; opacity: 0.55; filter: saturate(0.8); }
  .terminal { width: 92%; align-self: end; justify-self: start; margin-top: 30%; border-radius: var(--radius); overflow: hidden; }
  .term-bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--line); color: var(--text-3); font-size: 12px; }
  .tb-dots { display: flex; gap: 6px; margin-right: 6px; }
  .tb-dots i { width: 9px; height: 9px; border-radius: 50%; background: rgb(255 255 255 / 0.14); }
  .term-bar :global(.icon) { width: 16px; height: 16px; color: var(--accent-bright); }
  .term-lines { padding: 10px 6px; }
  .term-lines li { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 14px; padding: 9px 12px; border-radius: var(--r-xs); transition: background-color 0.4s; }
  .term-lines li:hover, .term-lines li.cur { background: rgb(61 139 255 / 0.08); }
  .term-lines li::before { content: ""; position: absolute; left: 0; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--accent-bright); box-shadow: 0 0 10px var(--accent); opacity: 0; transition: opacity 0.4s; }
  .term-lines li.cur::before { opacity: 1; }
  .term-lines code { font-size: 12.5px; color: var(--silver); word-break: break-all; }
  .prompt { color: var(--accent-bright); margin-right: 8px; }
  .term-meta { display: inline-flex; align-items: center; gap: 6px; }
  .dur { color: var(--text-3); font-size: 11.5px; min-width: 62px; text-align: right; }

  @media (max-width: 1000px) {
    .ch-grid, .ch-grid.reverse { grid-template-columns: 1fr; }
    .ch-grid.reverse .ch-copy { order: 0; }
    .gaming-visual { padding-bottom: 0; }
    .g-analysis { position: relative; left: auto; width: 70%; margin: -14% 0 0 4%; transform: none !important; }
    .storage-visual { padding-bottom: 0; }
    .volume { position: relative; right: auto; width: auto; margin: -12% 4% 0; transform: none !important; }
    .repair-shot { width: 100%; }
    .terminal { width: 100%; margin-top: 0; align-self: start; transform: none !important; }
    .repair-visual { gap: 16px; padding-block: 0; }
    .repair-visual > * { grid-area: auto; }
    .repair-shot { transform: none !important; opacity: 0.9; }
  }
  @media (max-width: 560px) {
    .term-lines code { font-size: 11.5px; }
    .g-analysis { width: 88%; }
    .volume { margin: -8% 0 0; padding: 20px; }
  }

  /* Also inside */
  .more { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; padding: 26px 0; margin-top: clamp(20px, 4vw, 40px); border-block: 1px solid var(--line); }
  .more-title { color: var(--text-3); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; }
  .more ul { display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .more li { display: inline-flex; align-items: center; gap: 9px; font-size: 15px; color: var(--silver); }
  .more :global(.icon) { width: 18px; height: 18px; color: var(--accent-bright); }
  @media (max-width: 760px) { .more { grid-template-columns: 1fr; gap: 16px; } }

  /* ───────── Tour ───────── */
  .tour { padding-top: clamp(40px, 6vw, 80px); }
  .tour-tabs {
    position: relative; display: flex; gap: 4px; width: fit-content; max-width: 100%; margin-inline: auto; padding: 5px; border-radius: 16px;
    overflow-x: auto; scrollbar-width: none;
    background: rgb(11 15 23 / 0.7); box-shadow: 0 0 0 1px var(--line-strong) inset, 0 20px 40px -20px rgb(0 0 0 / 0.8);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  .tour-tabs::-webkit-scrollbar { display: none; }
  .tour-tabs button {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 8px; flex: none; height: 42px; padding: 0 16px; border: 0; border-radius: 12px;
    font: 500 14.5px/1 var(--font); color: var(--text-2); background: none; cursor: pointer; transition: color 0.25s;
  }
  .tour-tabs button:hover { color: var(--text); }
  .tour-tabs button[aria-selected="true"] { color: #fff; }
  .tt-n { font-size: 11px; color: var(--text-3); transition: color 0.25s; }
  [aria-selected="true"] .tt-n { color: rgb(255 255 255 / 0.75); }
  /* The ink under the selected tab glides to it (scripts below set its box). */
