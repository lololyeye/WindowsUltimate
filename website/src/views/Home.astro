---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import Shot from "../components/Shot.astro";
import ReleaseSync from "../components/ReleaseSync.astro";
import Demo from "../components/Demo.astro";
import { ui, type Lang } from "../i18n/ui";
import { GITHUB_URL, RELEASES_URL, pageHref } from "../lib/site";
import { latestRelease, version, formatSize, formatDate, sha256 } from "../lib/release";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const f = t.features;
const release = await latestRelease();
const v = version(release);
const size = formatSize(release.asset.size, lang);
const hash = sha256(release);
const home = pageHref(lang);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Windows Ultimate",
  operatingSystem: "Windows 11",
  applicationCategory: "UtilitiesApplication",
  softwareVersion: v,
  description: t.meta.description,
  downloadUrl: release.asset.url,
  fileSize: size,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  url: new URL(home, Astro.site).href,
  codeRepository: GITHUB_URL,
};

const pad = (i: number) => String(i).padStart(2, "0");
const tags: Record<string, string> = { ro: f.repair.readOnly, mod: f.repair.modifies, net: f.repair.internet };
const tagClass: Record<string, string> = { ro: "safe", mod: "mod", net: "info" };
const tierClass = ["safe", "info", "mod", "lock"];
const levelClass = ["safe", "low", "mod", "adv", "bad"];
const moreIcons = ["network", "eye", "gauge", "chip", "history", "globe"] as const;
const maxChanges = Math.max(...f.gaming.profileList.map((p) => p[2]));

const segTotal = f.storage.segments.reduce((a, s) => a + s[3], 0);
const tour = f.tour.pages;
const tourShot = (key: string) => (key === "dashboard" ? "dashboard" : `win-${key}`);
---
<Base lang={lang} path="" jsonLd={jsonLd}>
  <!-- ───────── Hero ───────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span class="idx">v<span data-r="version">{v}</span></span>{t.hero.eyebrowOs}</p>
        <h1 id="hero-title">{t.hero.title1}</h1>
        <p class="lead hero-lead">{t.hero.lead}</p>
        <div class="cta hero-cta">
          <a class="btn btn-primary btn-lg" href="#download">
            <Icon name="download" class="arrow" />{t.hero.download}
          </a>
          <a class="btn btn-glass btn-lg" href="#demo">{t.hero.explore}<Icon name="arrow" class="chev" /></a>
        </div>
        <p class="hero-meta mono">{t.hero.meta(size)}</p>
      </div>

      <!-- Two real windows of the app, one behind the other. Pointer and scroll move them by depth. -->
      <div class="hero-stage" data-stage data-live>
        <div class="stage-light" aria-hidden="true"></div>
        <figure class="window back" style="--d: -10">
          <Shot lang={lang} name="win-gaming" alt={t.hero.backAlt} sizes="(min-width: 1100px) 46vw, 70vw" widths={[800, 1200]} eager />
        </figure>
        <figure class="window front" style="--d: 8">
          <div class="window-frame">
            <Shot lang={lang} name="dashboard" alt={t.hero.shotAlt} sizes="(min-width: 1100px) 60vw, 94vw" widths={[800, 1200, 1600]} eager class="window-img" />
            <span class="window-sheen" aria-hidden="true"></span>
          </div>
          <figcaption class="mono"><span class="led" aria-hidden="true"></span>{t.hero.chipUser}<span class="sep" aria-hidden="true">·</span>{t.hero.caption}</figcaption>
        </figure>
        <div class="reflection" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ───────── The problem ───────── -->
  <section id="overview" class="problem" aria-labelledby="overview-title">
    <div class="wrap">
      <p class="eyebrow reveal"><span class="idx">01</span>{t.problem.eyebrow}</p>
      <h2 id="overview-title" class="statement" data-scrub>{t.overview.statement}</h2>

      <table class="versus reveal">
        <thead>
          <tr><th scope="col" class="mono">{t.problem.usualTitle}</th><th scope="col" class="mono"><Logo id="vs" class="vs-mark" />{t.problem.oursTitle}</th></tr>
        </thead>
        <tbody>
          {t.problem.usual.map((x, i) => (
            <tr style={`--i:${i}`}>
              <td class="vs-usual"><div class="vc"><span class="vs-n mono">{pad(i + 1)}</span><span class="vs-x">{x}</span></div></td>
              <td class="vs-ours"><div class="vc"><Icon name="check" /><span>{t.problem.ours[i]}</span></div></td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="myths reveal">
        <div>
          <h3>{t.trust.mythsTitle}</h3>
          <p>{t.trust.mythsLead}</p>
        </div>
        <ul>
          {t.trust.myths.map((m) => <li><s>{m}</s></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────── Demonstration ───────── -->
  <section id="demo" class="demo-sec" aria-labelledby="demo-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">02</span>{t.demo.eyebrow}</p>
        <h2 id="demo-title">{t.demo.title}</h2>
        <p>{t.demo.lead}</p>
      </div>
      <div class="reveal"><Demo lang={lang} /></div>
    </div>
  </section>

  <!-- ───────── Features ───────── -->
  <section id="features" class="features" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">03</span>{f.eyebrow}</p>
        <h2 id="features-title">{f.title}</h2>
        <p>{f.lead}</p>
      </div>
    </div>

    <!-- Gaming: the real profiles, and a picker that reads them out. -->
    <article class="chapter ch-gaming" aria-labelledby="ch-gaming">
      <div class="wrap">
        <div class="ch-grid">
          <div class="ch-copy reveal">
            <p class="ch-label">{f.gaming.label}</p>
            <h3 id="ch-gaming">{f.gaming.title}</h3>
            <p class="ch-text">{f.gaming.text}</p>
            <ul class="ticks">
              {f.gaming.points.map((p) => <li><Icon name="check" />{p}</li>)}
            </ul>
          </div>
          <div class="ch-visual gaming-visual">
            <figure class="panel g-profiles reveal" data-delay="1">
              <Shot lang={lang} name="d-profiles" alt={f.gaming.profilesAlt} sizes="(min-width: 1000px) 58vw, 94vw" widths={[640, 960, 1268]} />
            </figure>
            <figure class="panel g-analysis reveal" data-delay="2" data-parallax="-0.06">
              <Shot lang={lang} name="d-analysis" alt={f.gaming.analysisAlt} sizes="(min-width: 1000px) 30vw, 80vw" widths={[400, 626]} />
            </figure>
          </div>
        </div>

        <div class="picker reveal" data-picker>
          <div class="pk-head">
            <p class="pk-title">{f.gaming.pickTitle}</p>
            <p class="pk-hint">{f.gaming.pickHint}</p>
          </div>
          <div class="pk-list" role="tablist" aria-label={f.gaming.pickTitle}>
            {f.gaming.profileList.map(([name], i) => (
              <button type="button" role="tab" id={`pk-tab-${i}`} aria-controls={`pk-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                <span class="pk-dot"></span>{i === 0 && <Icon name="bolt" class="pk-bolt" />}{name}
              </button>
            ))}
          </div>
          <div class="pk-panels">
            {f.gaming.profileList.map(([name, desc, n], i) => (
              <div class="pk-panel" role="tabpanel" id={`pk-panel-${i}`} aria-labelledby={`pk-tab-${i}`} hidden={i !== 0}>
                <h4>{name}</h4>
                <p>{desc}</p>
                <div class="pk-count">
                  <span class="pk-bars" aria-hidden="true">{Array.from({ length: maxChanges }, (_, k) => <i class:list={[k < n && "on"]}></i>)}</span>
                  <span class="mono">{f.gaming.changes(n)}</span>
                </div>
              </div>
            ))}
          </div>
          <blockquote class="quote">
            <p>{lang === "fr" ? `« ${f.gaming.quote} »` : `“${f.gaming.quote}”`}</p>
            <footer class="mono">{f.gaming.quoteBy}</footer>
          </blockquote>
        </div>
      </div>
    </article>

    <!-- Monitoring: an instrument strip (illustration), then the real monitor. -->
    <article class="chapter ch-monitor" aria-labelledby="ch-monitor">
      <div class="wrap">
        <div class="split-head reveal">
          <div>
            <p class="ch-label">{f.monitor.label}</p>
            <h3 id="ch-monitor">{f.monitor.title}</h3>
          </div>
          <p class="ch-text">{f.monitor.text}</p>
        </div>
        <figure class="panel monitor-panel reveal" data-anim="scan">
          <Shot lang={lang} name="monitor" alt={f.monitor.alt} sizes="(min-width: 1240px) 1200px, 94vw" widths={[640, 960, 1286]} />
          <span class="scanline" aria-hidden="true"></span>
        </figure>
        <p class="footnote reveal"><Icon name="alert" />{f.monitor.note}</p>
        <div class="monitor-more">
          <div class="note reveal">
            <h4><Icon name="gauge" />{f.monitor.bench}</h4>
            <p>{f.monitor.benchText}</p>
          </div>
          <div class="note net-note reveal" data-delay="1">
            <h4><Icon name="network" />{f.monitor.net}</h4>
            <p>{f.monitor.netText}</p>
            <figure class="net-shot">
              <Shot lang={lang} name="network" alt={f.monitor.netAlt} sizes="(min-width: 1000px) 520px, 90vw" widths={[330, 660]} />
            </figure>
          </div>
        </div>
      </div>
    </article>

    <!-- Debloat: the classification, drawn as four lanes. -->
    <article class="chapter ch-debloat" aria-labelledby="ch-debloat">
      <div class="wrap">
        <div class="ch-copy narrow reveal">
          <p class="ch-label">{f.debloat.label}</p>
          <h3 id="ch-debloat">{f.debloat.title}</h3>
          <p class="ch-text">{f.debloat.text}</p>
        </div>
        <div class="sorter reveal" data-anim="sort">
          <p class="src mono"><Icon name="layers" />{f.debloat.capture}</p>
          <svg class="branches" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            {[50, 150, 250, 350].map((x) => <path d={`M200 0 C200 34 ${x} 26 ${x} 60`} pathLength="1" />)}
          </svg>
          <ol class="lanes">
            {f.debloat.tiers.map(([name, text], i) => (
              <li class={tierClass[i]} style={`--i:${i}`}>
                <p class="ln-head"><span class="tier-dot" aria-hidden="true"></span>{name}</p>
                <p class="ln-count mono">{f.debloat.counts[i] ?? <><Icon name="lock" />{f.debloat.locked}</>}</p>
                <p class="ln-text">{text}</p>
                <ul class="ln-ex">{f.debloat.examples[i].map((x) => <li>{x}</li>)}</ul>
              </li>
            ))}
          </ol>
        </div>
        <figure class="panel debloat-shot reveal" data-parallax="0.03">
          <Shot lang={lang} name="debloat" alt={f.debloat.alt} sizes="(min-width: 1240px) 1100px, 94vw" />
        </figure>
        <div class="pair">
          <div class="reveal"><h4><Icon name="bolt" />{f.debloat.startup}</h4><p>{f.debloat.startupText}</p></div>
          <div class="reveal" data-delay="1"><h4><Icon name="eye" />{f.debloat.privacy}</h4><p>{f.debloat.privacyText}</p></div>
        </div>
      </div>
    </article>

    <!-- Storage: what was found, to scale. -->
    <article class="chapter ch-storage" aria-labelledby="ch-storage">
      <div class="wrap ch-grid reverse">
        <div class="ch-copy reveal">
          <p class="ch-label">{f.storage.label}</p>
          <h3 id="ch-storage">{f.storage.title}</h3>
          <p class="ch-text">{f.storage.text}</p>
          <ul class="ticks">
            {f.storage.points.map((p) => <li><Icon name="check" />{p}</li>)}
          </ul>
          <p class="never-title mono">{f.storage.never}</p>
          <ul class="never">
            {f.storage.neverList.map((p) => <li><Icon name="lock" />{p}</li>)}
          </ul>
        </div>
        <div class="ch-visual storage-visual">
          <figure class="panel tilt-r st-shot reveal" data-delay="1">
            <Shot lang={lang} name="storage" alt={f.storage.alt} sizes="(min-width: 1000px) 58vw, 94vw" />
          </figure>
          <div class="volume glass glass-3 reveal" data-delay="2" data-anim="fill" data-parallax="-0.05">
            <p class="vol-total"><span class="vol-n" data-count={f.storage.found}>{f.storage.found}</span><span class="vol-t">{f.storage.foundText}</span></p>
            <div class="vol-bar" aria-hidden="true">
              {f.storage.segments.map(([, , , n, c], i) => <span class={c} style={`--w:${((n / segTotal) * 100).toFixed(2)}; --i:${i}`}></span>)}
            </div>
            <dl class="vol-legend">
              {f.storage.segments.map(([name, sub, val, , c]) => (
                <div class={c}><dt><span class="sw-dot"></span>{name}<small>{sub}</small></dt><dd class="mono">{val}</dd></div>
              ))}
            </dl>
            <p class="vol-note">{f.storage.vizNote}</p>
          </div>
        </div>
      </div>
    </article>

    <!-- Repair: Windows' own tools, in a terminal that steps through them. -->
    <article class="chapter ch-repair" aria-labelledby="ch-repair">
      <div class="wrap ch-grid">
        <div class="ch-copy reveal">
          <p class="ch-label">{f.repair.label}</p>
          <h3 id="ch-repair">{f.repair.title}</h3>
          <p class="ch-text">{f.repair.text}</p>
          <ul class="ticks">
            {f.repair.points.map((p) => <li><Icon name="check" />{p}</li>)}
          </ul>
        </div>
        <div class="ch-visual repair-visual">
          <figure class="panel repair-shot reveal" data-parallax="0.05">
            <Shot lang={lang} name="repair" alt={f.repair.alt} sizes="(min-width: 1000px) 50vw, 94vw" />
          </figure>
          <div class="terminal glass glass-3 reveal" data-delay="2" data-parallax="-0.05" data-live data-cycle>
            <div class="term-bar"><span class="tb-dots" aria-hidden="true"><i></i><i></i><i></i></span><Icon name="pulse" /><span class="mono">Windows Ultimate · {f.repair.label}</span></div>
            <ol class="term-lines" data-stagger>
              {f.repair.cmds.map(([cmd, kind, dur]) => (
                <li>
                  <code><span class="prompt">›</span>{cmd}</code>
                  <span class="term-meta">
                    {kind.split(" ").map((k) => <span class={`tag ${tagClass[k]}`}>{tags[k]}</span>)}
                    <span class="dur mono">{dur}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </article>

    <div class="wrap">
      <div class="more reveal">
        <p class="mono more-title">{f.more}</p>
        <ul data-stagger>
          {f.moreItems.map((m, i) => <li><Icon name={moreIcons[i]} />{m}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────── Tour ───────── -->
  <section id="tour" class="tour" aria-labelledby="tour-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">04</span>{f.tour.eyebrow}</p>
        <h2 id="tour-title">{f.tour.title}</h2>
        <p>{f.tour.lead}</p>
      </div>
      <div class="tour-ui reveal" data-tour>
        <div class="tour-tabs" role="tablist" aria-label={f.tour.title}>
          {tour.map(([key, label], i) => (
            <button type="button" role="tab" id={`tour-tab-${key}`} aria-controls={`tour-${key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              <span class="tt-n mono">{pad(i + 1)}</span>{label}
            </button>
          ))}
          <span class="tour-ink" aria-hidden="true"></span>
        </div>
        <div class="tour-stage">
          <div class="tour-glow" aria-hidden="true"></div>
          <div class="tour-frame">
            {tour.map(([key, label, text], i) => (
              <figure class="tour-panel" role="tabpanel" id={`tour-${key}`} aria-labelledby={`tour-tab-${key}`} hidden={i !== 0}>
                <Shot lang={lang} name={tourShot(key)} alt={`${label}: ${text}`} sizes="(min-width: 1240px) 1200px, 94vw" widths={[800, 1200, 1600]} />
                <figcaption><span class="mono">{pad(i + 1)} / {pad(tour.length)}</span>{text}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Technology ───────── -->
  <section id="technology" class="tech" aria-labelledby="tech-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">05</span>{t.tech.eyebrow}</p>
        <h2 id="tech-title">{t.tech.title}</h2>
        <p>{t.tech.lead}</p>
      </div>

      <div class="tech-grid">
        <div class="risk reveal">
          <h3>{t.tech.risk}</h3>
          <p>{t.tech.riskText}</p>
          <ol class="levels">
            {t.tech.levels.map((l, i) => <li class={levelClass[i]}><span class="bar"></span><span class="mono">{l}</span></li>)}
          </ol>
          <figure class="risk-shot">
            <Shot lang={lang} name="responsiveness" alt={t.tech.riskAlt} sizes="(min-width: 1000px) 520px, 90vw" widths={[640, 960, 1298]} />
          </figure>
        </div>
        <div class="history reveal" data-delay="1">
          <h3>{t.tech.historyTitle}</h3>
          <p>{t.tech.historyText}</p>
          <figure class="panel">
            <Shot lang={lang} name="history" alt={t.tech.historyAlt} sizes="(min-width: 1000px) 640px, 94vw" widths={[640, 960, 1298]} />
          </figure>
          <div class="details">
            <p class="details-title mono">{t.tech.detailsTitle}</p>
            {t.tech.details.map(([q, a]) => (
              <details>
                <summary>{q}<span class="sum-ico" aria-hidden="true"></span></summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Trust ───────── -->
  <section id="trust" class="trust" aria-labelledby="trust-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="idx">06</span>{t.trust.eyebrow}</p>
        <h2 id="trust-title">{t.trust.title}</h2>
        <p>{t.trust.lead}</p>
      </div>

      <ol class="ledger" data-stagger>
        {t.trust.principles.map(([name, text], i) => (
          <li>
            <span class="lg-n mono">{pad(i + 1)}</span>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>

      <div class="perm reveal">
        <div class="perm-head">
          <h3>{t.trust.permTitle}</h3>
          <p>{t.trust.permLead}</p>
        </div>
        <div class="perm-levels">
          <div class="pl pl-user">
            <p class="pl-title"><span class="led"></span>{t.trust.user}</p>
            <ul>{t.trust.userList.map((x) => <li><Icon name="check" />{x}</li>)}</ul>
          </div>
          <div class="pl pl-admin">
            <p class="pl-title"><span class="led"></span>{t.trust.admin}</p>
            <ul>{t.trust.adminList.map((x) => <li><Icon name="key" />{x}</li>)}</ul>
            <p class="pl-note mono">{t.trust.adminNote}</p>
          </div>
          <div class="pl pl-confirm">
            <p class="pl-title"><span class="led"></span>{t.trust.confirm}</p>
            <ul>{t.trust.confirmList.map((x) => <li><Icon name="alert" />{x}</li>)}</ul>
            <div class="confirm-steps" aria-hidden="true"><span>1</span><i></i><span>2</span></div>
          </div>
        </div>
      </div>

      <div class="limits reveal">
        <h3 class="mono">{t.trust.limitsTitle}</h3>
        <ul>{t.trust.limits.map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ───────── Download ───────── -->
  <section id="download" class="download" aria-labelledby="download-title">
    <div class="wrap">
      <div class="dl">
        <div class="dl-card glass glass-3 reveal">
          <div class="dl-mark" aria-hidden="true"><Logo id="dl" /></div>
          <p class="eyebrow">{t.download.eyebrow}</p>
          <h2 id="download-title">{t.download.title}</h2>
          <p class="dl-lead">{t.download.lead}</p>
          <div class="dl-file">
            <span class="df-icon" aria-hidden="true"><Icon name="download" /></span>
            <span class="df-name mono" data-r="name">{release.asset.name}</span>
            <span class="df-size mono" data-r="size">{size}</span>
          </div>
          <a class="btn btn-primary btn-lg dl-btn" href={release.asset.url} data-r="href:asset">
            <Icon name="download" class="arrow" />{t.download.button}
          </a>
          <p class="dl-sub mono">Windows Ultimate <span data-r="version">{v}</span> · <time datetime={release.publishedAt} data-r="date">{formatDate(release.publishedAt, lang)}</time></p>
          <div class="dl-links">
            <a href={release.url} data-r="href:url"><Icon name="notes" />{t.download.notes}</a>
            <a href={RELEASES_URL}><Icon name="history" />{t.download.all}</a>
            <a href={GITHUB_URL}><Icon name="github" />{t.download.source}</a>
          </div>
        </div>

        <ol class="dl-steps">
          {t.download.steps.map(([name, text], i) => (
            <li class="reveal" data-delay={String(i + 1)}>
              <span class="ds-n mono" aria-hidden="true">{pad(i + 1)}</span>
              <div class="ds-body">
                <h3>{name}</h3>
                <p>{text}</p>
                {i === 1 && (
                  <div class="hash-box">
                    <p class="hash-title mono">{t.download.hashTitle}</p>
                    {hash ? (
                      <>
                        <div class="hash-row">
                          <code id="sha" class="hash" data-r="hash">{hash}</code>
                          <button class="btn btn-glass btn-sm copy" type="button" data-copy="#sha" data-copied={t.download.copied} data-fail={t.download.copyFail}>
                            <Icon name="copy" /><span class="copy-label">{t.download.copy}</span>
                          </button>
                        </div>
                        <p class="hash-help">{t.download.hashText}</p>
                        <code class="cmd">Get-FileHash .\<span data-r="name">{release.asset.name}</span> -Algorithm SHA256</code>
                      </>
                    ) : (
                      <p class="hash-help">{t.download.noHash}</p>
                    )}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
