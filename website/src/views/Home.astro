  </section>

  <ReleaseSync lang={lang} />
</Base>

<style>
  /* ───────── Hero ───────── */
  .hero { padding-block: clamp(40px, 6vw, 84px) clamp(64px, 8vw, 112px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 500px) minmax(0, 1fr); gap: clamp(32px, 4vw, 64px); align-items: center; }
  .hero-copy { position: relative; z-index: 3; display: grid; justify-items: start; }
  h1 { font-size: var(--fs-display); line-height: 1.02; letter-spacing: -0.045em; margin-block: 26px 22px; max-width: 11ch; }
  :global(html[lang="fr"]) h1 { max-width: 14ch; font-size: clamp(2.4rem, 3.9vw, 3.4rem); }
  .lead { color: var(--text-2); font-size: var(--fs-lead); line-height: 1.6; max-width: 42ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero-meta { margin-top: 20px; color: var(--text-3); font-size: 12.5px; letter-spacing: 0.01em; }

  /* Intro, in one sequence: label, title word by word, text, buttons; the windows land underneath. */
  :global(.js) .hero-eyebrow, :global(.js) .hero-lead, :global(.js) .hero-cta, :global(.js) .hero-meta { animation: rise 0.9s var(--ease-out) both; }
  :global(.js) .hero-eyebrow { animation-delay: 0.1s; }
  :global(.js) h1 { --d: 0.2s; }
  :global(.js) .hero-lead { animation-delay: 0.5s; }
  :global(.js) .hero-cta { animation-delay: 0.62s; }
  :global(.js) .hero-meta { animation-delay: 0.74s; }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }

  /* The stage. --p (scroll, 0 → 1) straightens the windows; --mx/--my (pointer) shift each one by its depth --d. */
  .hero-stage { --p: 0; --mx: 0; --my: 0; position: relative; margin-right: calc(-1 * clamp(40px, 10vw, 200px)); perspective: 2400px; padding-block: 15% 70px; }
  /* One cool light from the top left, behind the glass. */
  .stage-light {
    position: absolute; inset: -18% -10% 0 -16%; z-index: -1; pointer-events: none;
    background: radial-gradient(42% 46% at 38% 40%, rgb(61 139 255 / 0.26), transparent 72%), radial-gradient(30% 30% at 78% 82%, rgb(138 114 240 / 0.12), transparent 70%);
  }
  .window { position: relative; margin: 0; translate: calc(var(--mx) * var(--d) * 1px) calc(var(--my) * var(--d) * 1px); }
  .window :global(img) { width: 100%; }
  .front {
    z-index: 2; transform-origin: 0% 50%;
    transform: rotateY(calc(-14deg * (1 - var(--p)))) rotateX(calc(5deg * (1 - var(--p))));
  }
  /* The Gaming page, set back and dimmed: depth without repeating what the front window shows. */
  .back {
    position: absolute; z-index: 1; top: 0; right: 8%; width: 58%;
    border-radius: 12px; overflow: hidden; opacity: 0.5; filter: saturate(0.75) brightness(0.85);
    transform-origin: 100% 0%;
    transform: rotateY(calc(-14deg * (1 - var(--p)))) translateZ(-160px) translateY(calc(-30% + 8% * var(--p)));
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1), 0 30px 60px -30px rgb(0 0 0 / 0.8);
    -webkit-mask-image: linear-gradient(180deg, #000 35%, transparent 80%); mask-image: linear-gradient(180deg, #000 35%, transparent 80%);
  }
  .window-frame {
    position: relative; overflow: hidden; border-radius: 14px; background: #0b0f17;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1), 0 70px 120px -40px rgb(0 0 0 / 0.9), 0 30px 90px -50px rgb(61 139 255 / 0.6);
  }
  /* The glass edge: a hairline that is brightest where the light comes from. */
  .window-frame::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.4), rgb(255 255 255 / 0.06) 24%, rgb(255 255 255 / 0.03) 70%, rgb(125 180 255 / 0.2));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  }
  /* A soft reflection on the glass that slides as the window turns. */
  .window-sheen {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.06) 40%, rgb(255 255 255 / 0.01) 50%, transparent 58%);
    transform: translateX(calc(-22% * var(--p) + var(--mx) * 3%));
  }
  .window figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 18px; padding-right: clamp(40px, 10vw, 200px); color: var(--text-3); font-size: 12px; }
  .window .led { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px rgb(52 211 153 / 0.16); }
  .window figcaption .sep { opacity: 0.5; }
  /* Light pooling on the surface under the window. */
  .reflection { position: absolute; left: 6%; right: 14%; bottom: 30px; height: 70px; z-index: 0; background: radial-gradient(50% 50% at 50% 50%, rgb(61 139 255 / 0.28), transparent 70%); filter: blur(16px); pointer-events: none; }

  :global(.js) .front { animation: land 1.4s var(--ease-out) 0.3s backwards; }
  :global(.js) .back { animation: land-back 1.6s var(--ease-out) 0.6s backwards; }
  @keyframes land { from { opacity: 0; translate: 40px 28px; } }
  @keyframes land-back { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .front, :global(.js) .back { animation-name: fade-in; }
    @keyframes fade-in { from { opacity: 0; } }
  }

