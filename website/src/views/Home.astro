  /* What it won't do: a plain list of struck names, set like an index. */
  .myths { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 72px); margin-top: clamp(64px, 9vw, 112px); padding-top: 28px; border-top: 1px solid var(--line); align-items: start; }
  .myths h3 { font-size: var(--fs-h4); letter-spacing: -0.02em; }
