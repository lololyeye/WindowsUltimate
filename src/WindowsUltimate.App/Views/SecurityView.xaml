<UserControl x:Class="WindowsUltimate.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WindowsUltimate.App.Localization"
             xmlns:svc="clr-namespace:WindowsUltimate.App.Services">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource Inset}" Margin="0,0,0,16" Padding="16,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource B.Info}" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <TextBlock Text="{l:T SecurityDisclaimer}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Microsoft Defender -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{l:T OpenWindowsSecurity}" Command="{Binding OpenWindowsSecurityCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" />
                            <Button Content="{l:T Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource Btn.Ghost}" />
                        </StackPanel>
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,7,12,0" VerticalAlignment="Top" Fill="{Binding ProtectionSeverity, Converter={StaticResource SevBrush}}" />
                        <StackPanel>
                            <TextBlock Text="{l:T MicrosoftDefender}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Columns="4" Margin="0,0,0,14" Visibility="{Binding DefenderAvailable, Converter={StaticResource Vis}}">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:T RealTimeProtection}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding RealtimeText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:T Signatures}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding SignaturesText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{Binding SignaturesSeverity, Converter={StaticResource SevBrush}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:T LastQuickScan}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding LastQuickText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T LastFullScan}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding LastFullText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <WrapPanel Visibility="{Binding DefenderAvailable, Converter={StaticResource Vis}}">
                        <Button Content="{l:T QuickScan}" Command="{Binding QuickScanCommand}" Style="{StaticResource Btn.Primary}" Margin="0,0,8,8" />
                        <Button Content="{l:T FullScan}" Command="{Binding FullScanCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
                        <Button Content="{l:T UpdateSignatures}" Command="{Binding UpdateSignaturesCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
                        <Button Content="{l:T OfflineScan}" Command="{Binding OfflineScanCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8"
                                Visibility="{Binding IsAdvanced, Source={x:Static svc:UiMode.Instance}, Converter={StaticResource Vis}}" ToolTip="{l:T OfflineScanTip}" />
                        <Button Content="{l:T Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8"
                                Visibility="{Binding DefenderScanning, Converter={StaticResource Vis}}" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding DefenderScanning, Converter={StaticResource Vis}}">
                        <ProgressBar IsIndeterminate="True" Width="160" Height="3" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{l:T DefenderWorking}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                    </StackPanel>
                    <Border Style="{StaticResource Inset}" Padding="12,10" Margin="0,8,0,0" Visibility="{Binding ScanLog, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding ScanLog}" Style="{StaticResource Text.Body}" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>

                    <!-- Defender detections -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasThreats, Converter={StaticResource Vis}}">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{l:T RemoveThreats}" Command="{Binding RemoveThreatsCommand}" Style="{StaticResource Btn.Danger}" />
                            <TextBlock Text="{l:T DefenderDetections}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Threats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Text.Caption}" FontWeight="Normal" VerticalAlignment="Top" Margin="12,2,0,0" />
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal" VerticalAlignment="Center">
                                                        <Run Text="{Binding Severity, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detected, Mode=OneWay, StringFormat=g}" />
                                                    </TextBlock>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding ResourcesText}" Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource B.TextTertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Windows Ultimate review -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{l:T ExportReport}" Command="{Binding ExportCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0"
                                    Visibility="{Binding HasScan, Converter={StaticResource Vis}}" />
                            <Button Content="{l:T RunSecurityCheck}" Command="{Binding RunCheckCommand}" Style="{StaticResource Btn.Primary}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T SecurityCheckTitle}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{l:T SecurityCheckIntro}" Style="{StaticResource Text.Secondary}" Margin="0,4,16,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Text.Body}" FontSize="12.5" Margin="0,8,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{l:T NeedsAdminSecurity}" Style="{StaticResource Text.Secondary}" FontSize="12" Foreground="{StaticResource B.Warning}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding IsElevated, Converter={StaticResource NotVis}}" />

                    <Border Style="{StaticResource Inset}" Padding="14,12" Margin="0,0,0,10" Visibility="{Binding NoFindings, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource B.Success}" Margin="0,1,10,0" />
                            <TextBlock Text="{l:T NoFindings}" Style="{StaticResource Text.Body}" FontSize="12.5" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Background="{Binding SeverityKey, Converter={StaticResource SevSoft}}" Margin="0,1,10,0" VerticalAlignment="Top" MinWidth="64">
                                                <TextBlock Text="{Binding SeverityText}" Style="{StaticResource BadgeText}" Foreground="{Binding SeverityKey, Converter={StaticResource SevBrush}}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                <Button Content="{Binding RemedyLabel}" Command="{Binding RemedyCommand}" Padding="12,5" Margin="0,0,6,0"
                                                        Visibility="{Binding HasRemedy, Converter={StaticResource Vis}}" />
                                                <Button Style="{StaticResource Btn.Icon}" Command="{Binding ToggleCommand}" ToolTip="{l:T Details}" Content="&#xE70D;" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,3,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding CategoryText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ConfidenceText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Mono}" FontSize="11.5" Foreground="{StaticResource B.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Margin="74,10,0,0" Padding="14,12" Style="{StaticResource Inset}" Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap">
                                                    <Run Text="{l:T WhyFlagged}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Evidence, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                                                    <Run Text="{l:T HowDetected}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Method, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Text.Body}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0">
                                                    <Run Text="{l:T WhatToDo}" FontWeight="SemiBold" Foreground="{StaticResource B.AccentBright}" /><Run Text=": " /><Run Text="{Binding Recommendation, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource B.TextTertiary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding Sha256, Converter={StaticResource Vis}}">
                                                    <Run Text="SHA-256 " /><Run Text="{Binding Sha256, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,3,0,0" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Content="{l:T ScanWithDefender}" Command="{Binding ScanFileCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,6"
                                                            Visibility="{Binding FileExists, Converter={StaticResource Vis}}" />
                                                    <Button Content="{l:T LookupHash}" Command="{Binding LookupCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,6"
                                                            Visibility="{Binding Sha256, Converter={StaticResource Vis}}" />
                                                    <Button Content="{l:T OpenLocation}" Command="{Binding RevealCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,6" />
                                                    <Button Content="{l:T TrustIt}" Command="{Binding TrustCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,6" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasScan, Converter={StaticResource Vis}}">
                        <TextBlock Text="{l:T Limitations}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Limitations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{l:T ClearTrusted}" Command="{Binding ClearTrustCommand}" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Inventories (Advanced) -->
            <StackPanel Visibility="{Binding IsAdvanced, Source={x:Static svc:UiMode.Instance}, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Persistence.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{l:T PersistenceInventory}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{l:T PersistenceInventoryIntro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Persistence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,6" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Command}" Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource B.TextTertiary}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Command}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding Signer}" Style="{StaticResource Text.Secondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding Extensions.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{l:T ExtensionInventory}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{l:T ExtensionInventoryIntro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Extensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,6" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Browser}" Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Id}">
                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource B.TextTertiary}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource Text.Secondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding PermissionsText}" Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource B.TextTertiary}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
