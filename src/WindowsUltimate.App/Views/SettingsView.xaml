<UserControl x:Class="WindowsUltimate.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WindowsUltimate.App.Localization">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Languages}" SelectedValue="{Binding Language}" SelectedValuePath="Key" DisplayMemberPath="Value" Width="180" />
                        <StackPanel>
                            <TextBlock Text="{l:T Language}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:T LanguageNote}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding CreateRestorePoint}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{l:T RestorePointDefault}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:T RestorePointDefaultNote}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T DataAndPrivacy}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                    <TextBlock Text="{l:T DataNote}" Style="{StaticResource Text.Secondary}" FontSize="12.5" />
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="{l:T Open}" Command="{Binding OpenDataCommand}" Style="{StaticResource Btn.Ghost}" />
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Text.Mono}" FontSize="11.5" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T Principles}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                    <TextBlock Text="{l:T PrinciplesText}" Style="{StaticResource Text.Secondary}" FontSize="12.5" LineHeight="20" />
                    <TextBlock Text="{l:T HowScoreWorks}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <TextBlock Text="{Binding Methodology}" Style="{StaticResource Text.Secondary}" FontSize="12.5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding CheckForUpdates}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{l:T UpdatesTitle}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:T UpdatesNote}" Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T ReleaseNotes}" Command="{Binding OpenReleasesCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" />
                            <Button Content="{l:T CheckForUpdatesNow}" Command="{Binding CheckUpdatesCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Mono}" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource B.TextSecondary}">
                            <Run Text="{Binding Version, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding UpdateSource, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T About}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Secondary}"><Run Text="Windows Ultimate " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{l:T AboutText}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
