<UserControl x:Class="WindowsUltimate.App.Views.RepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WindowsUltimate.App.Localization">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T RepairTools}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{l:T RepairIntro}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,4,0,12" />
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{l:T Run}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <Border Style="{StaticResource Badge}" Background="{StaticResource B.WarningSoft}" Margin="0,0,6,0" Visibility="{Binding ModifiesSystem, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{l:T Modifies}" Style="{StaticResource BadgeText}" Foreground="{StaticResource B.Warning}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Background="{StaticResource B.SuccessSoft}" Margin="0,0,6,0" Visibility="{Binding ModifiesSystem, Converter={StaticResource NotVis}}">
                                                        <TextBlock Text="{l:T ReadOnly}" Style="{StaticResource BadgeText}" Foreground="{StaticResource B.Success}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Visibility="{Binding NeedsInternet, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{l:T Internet}" Style="{StaticResource BadgeText}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3,0,0" />
                                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource B.TextTertiary}" Margin="0,3,0,0">
                                                    <Run Text="{Binding CommandLine, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Duration, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{l:T Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource Btn.Ghost}" />
                            <TextBlock Style="{StaticResource Text.Section}" VerticalAlignment="Center">
                                <Run Text="{l:T Output}" /><Run Text="  " /><Run Text="{Binding Running, Mode=OneWay}" Foreground="{StaticResource B.Accent}" />
                            </TextBlock>
                        </DockPanel>
                        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                        <Border Style="{StaticResource Well}" Padding="12" MinHeight="380">
                            <TextBox x:Name="ConsoleBox" Text="{Binding Console, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{StaticResource B.TextSecondary}" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" MaxHeight="520" TextChanged="OnConsoleChanged" />
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{l:T CheckUpdates}" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" />
                                <Button Content="Windows Update" Command="{Binding OpenWindowsUpdateCommand}" Style="{StaticResource Btn.Ghost}" />
                            </StackPanel>
                            <TextBlock Text="{l:T UpdateHealth}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Status}" />
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,7" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" FontSize="12">
                                                <Run Text="{Binding StartType, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                            </TextBlock>
                                            <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource B.Danger}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHealthy}" Value="True"><Setter Property="Fill" Value="{StaticResource B.Success}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}" ToolTip="{Binding Name}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding UpdatesText}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" Visibility="{Binding UpdatesText, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding PendingUpdates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat=•  {0}}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,2" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{l:T OpenTroubleshooters}" Command="{Binding OpenTroubleshootCommand}" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T DiskHealth}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                        <TextBlock Text="{l:T DiskHealthNone}" Style="{StaticResource Text.Secondary}" FontSize="12" Visibility="{Binding Disks.Count, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceId, StringFormat=Disk {0}}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding TemperatureC, StringFormat={}{0} °C, TargetNullValue=— °C, Mode=OneWay}" /><Run Text="  ·  wear " /><Run Text="{Binding WearPercent, StringFormat={}{0} %, TargetNullValue=—, Mode=OneWay}" />
                                                <Run Text="  ·  read errors " /><Run Text="{Binding ReadErrors, TargetNullValue=—, Mode=OneWay}" /><Run Text="  ·  write errors " /><Run Text="{Binding WriteErrors, TargetNullValue=—, Mode=OneWay}" />
                                                <Run Text="  ·  " /><Run Text="{Binding PowerOnHours, StringFormat={}{0} h, TargetNullValue=—, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T ReadEventLogs}" Command="{Binding ScanEventsCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" />
                            <Button Content="{l:T ReliabilityMonitor}" Command="{Binding OpenReliabilityCommand}" Style="{StaticResource Btn.Ghost}" />
                        </StackPanel>
                        <TextBlock Text="{l:T EventsTitle}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,6" Foreground="{StaticResource B.Text}">
                                    <Expander.Header>
                                        <DockPanel Width="700">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="24,6,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="11.5" Foreground="{StaticResource B.TextSecondary}" Margin="0,2" TextWrapping="Wrap">
                                                    <Run Text="{Binding Time, StringFormat=g, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" #" /><Run Text="{Binding EventId, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
