<UserControl x:Class="WindowsUltimate.App.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WindowsUltimate.App.Localization">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <!-- Profiles -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="{l:T RestorePrevious}" Command="{Binding RestorePreviousCommand}" Style="{StaticResource Btn.Ghost}" />
                        <TextBlock Text="{l:T Profiles}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ActiveProfileText}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,10" Padding="16,14">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Inset}">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Right" Content="{l:T Activate}" Command="{Binding ActivateCommand}" CommandParameter="{Binding Profile}" Padding="12,5" />
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Foreground="{StaticResource B.Violet}" Margin="0,0,8,0"
                                                           Visibility="{Binding IsSmart, Converter={StaticResource Vis}}" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource B.AccentSoft}" Margin="8,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{l:T Active}" Style="{StaticResource BadgeText}" Foreground="{StaticResource B.Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{l:T Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource Btn.Ghost}" />
                            <TextBlock Text="{l:T GamingAnalysis}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Checks}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T OverlaysTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                        <TextBlock Text="{l:T OverlaysIntro}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,8" />
                        <TextBlock Text="{l:T NoOverlays}" Style="{StaticResource Text.Secondary}" Visibility="{Binding HasOverlays, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Overlays}" />
                        <Border Style="{StaticResource Inset}" Margin="0,14,0,0">
                            <TextBlock Text="{l:T GamingHonesty}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T GamingTweaks}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{l:T GamingTweaksIntro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,14" />
                    <ContentControl Content="{Binding Tweaks}" Focusable="False" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
