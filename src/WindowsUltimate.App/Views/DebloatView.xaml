<UserControl x:Class="WindowsUltimate.App.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WindowsUltimate.App.Localization">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" />
                            <Button Content="{l:T SelectSafe}" Command="{Binding SelectSafeCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" />
                            <Button Command="{Binding RemoveCommand}" Style="{StaticResource Btn.Danger}">
                                <TextBlock><Run Text="{l:T PreviewRemoval}" /><Run Text=" (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{l:T InstalledAppsTitle}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" />
                    <TextBlock Text="{l:T DebloatIntro}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Severity, Converter={StaticResource SevBrush}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" />
                                    <TextBlock Text="{Binding Count, StringFormat=  ·  {0}}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="18,4,0,12" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Inset}" Margin="0,0,8,8" Padding="12,10">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{StaticResource B.TextTertiary}" Margin="8,0,0,0"
                                                               ToolTip="{l:T ProtectedPackage}" Visibility="{Binding Protected, Converter={StaticResource Vis}}" VerticalAlignment="Top" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding PackageName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Version, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding WhatItDoes}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,4,0,0"
                                                                   Visibility="{Binding WhatItDoes, Converter={StaticResource Vis}}" />
                                                        <TextBlock Text="{Binding Consequences}" Style="{StaticResource Text.Secondary}" FontSize="12" Foreground="{StaticResource B.Warning}" Margin="0,2,0,0"
                                                                   Visibility="{Binding Consequences, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T ConsumerFeatures}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{l:T ConsumerFeaturesIntro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,14" />
                    <ContentControl Content="{Binding Tweaks}" Focusable="False" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T OpenWindowsFeatures}" Command="{Binding OpenFeaturesCommand}" Style="{StaticResource Btn.Ghost}" />
                        <TextBlock Text="{l:T OptionalFeaturesTitle}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{l:T OptionalFeaturesIntro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,10" />
                    <TextBlock Text="{Binding FeaturesError}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource B.Warning}" Visibility="{Binding FeaturesError, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Background" Value="{StaticResource B.AccentSoft}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                        <Setter Property="Text" Value="{l:T Off}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Text" Value="{l:T On}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Secondary}" FontSize="12" Visibility="{Binding Advice, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
