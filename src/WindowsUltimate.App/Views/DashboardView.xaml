<UserControl x:Class="WindowsUltimate.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WindowsUltimate.App.Localization"
             xmlns:ui="clr-namespace:WindowsUltimate.App.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <!-- ── Row 1: health + live ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Health score -->
                <Border Style="{StaticResource GlassCard}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{l:T SystemHealth}" Style="{StaticResource Text.Section}" />
                        <Grid Width="190" Height="190" Margin="0,16,0,8">
                            <ui:RingGauge Value="{Binding Score}" Maximum="100" Thickness="12" Brush="{Binding Score, Converter={StaticResource ScoreBrush}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Score}" FontFamily="{StaticResource F.Display}" FontSize="54" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Visibility="{Binding HasReport, Converter={StaticResource Vis}}" />
                                <TextBlock Text="—" FontFamily="{StaticResource F.Display}" FontSize="54" HorizontalAlignment="Center" Foreground="{StaticResource B.TextTertiary}"
                                           Visibility="{Binding HasReport, Converter={StaticResource NotVis}}" />
                                <TextBlock Text="{Binding ScoreLabel}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Text.Caption}" FontWeight="Normal" HorizontalAlignment="Center" TextAlignment="Center" />
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Button Content="{l:T QuickScan}" Command="{Binding QuickScanCommand}" Style="{StaticResource Btn.Primary}" Margin="0,0,4,0" />
                            <Button Content="{l:T FullAnalysis}" Command="{Binding FullScanCommand}" Margin="4,0,0,0" />
                        </UniformGrid>
                        <Button Content="{l:T HowScoreWorks}" Command="{Binding ToggleMethodologyCommand}" Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <StackPanel Visibility="{Binding ShowMethodology, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Methodology}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding Penalties}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScorePenalty, StringFormat=−{0}}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource B.Warning}" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Live usage -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CpuTemp}" Style="{StaticResource Text.Caption}" FontWeight="Normal" ToolTip="{l:T CpuTempNote}" />
                                    <TextBlock Text="CPU" Style="{StaticResource Text.Caption}" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Metric}" Margin="0,8,0,0">
                                    <Run Text="{Binding CpuPercent, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text="%" FontSize="16" Foreground="{StaticResource B.TextSecondary}" />
                                </TextBlock>
                                <ui:SparkChart Values="{Binding CpuHistory}" Maximum="100" Capacity="60" Stroke="{StaticResource B.Accent}" MinHeight="70" Margin="0,10,0,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding GpuTemp}" Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                                    <TextBlock Text="GPU" Style="{StaticResource Text.Caption}" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Metric}" Margin="0,8,0,0">
                                    <Run Text="{Binding GpuPercent, StringFormat={}{0:0}, TargetNullValue=—, Mode=OneWay}" /><Run Text="%" FontSize="16" Foreground="{StaticResource B.TextSecondary}" />
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding VramText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                                <ui:SparkChart Values="{Binding GpuHistory}" Maximum="100" Capacity="60" Stroke="{StaticResource B.Violet}" MinHeight="60" Margin="0,10,0,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{l:T Memory}" Style="{StaticResource Text.Caption}" />
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Metric}" Margin="0,8,0,0">
                                    <Run Text="{Binding RamPercent, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text="%" FontSize="16" Foreground="{StaticResource B.TextSecondary}" />
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding RamUsedText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                                <ui:SparkChart Values="{Binding RamHistory}" Maximum="100" Capacity="60" Stroke="{StaticResource B.Success}" MinHeight="60" Margin="0,10,0,0" />
                            </DockPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Safe recommendations -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A4D8DFF" Offset="0" />
                                <GradientStop Color="#0D8B6CFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding ApplySafeCommand}" Style="{StaticResource Btn.Primary}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock><Run Text="{l:T ReviewAndApply}" /><Run Text=" (" /><Run Text="{Binding SafeCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE945;" FontSize="20" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel>
                                <TextBlock Text="{l:T SafeRecommendations}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SafeSummary}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{l:T SafeRecommendationsNote}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ── Row 2: findings + system ── -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T WhatWeFound}" Style="{StaticResource Text.Section}" Margin="0,0,0,14" />
                        <TextBlock Text="{l:T ScanRunning}" Style="{StaticResource Text.Secondary}" Visibility="{Binding HasReport, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Findings}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T ThisPc}" Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </StackPanel.Resources>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Processor}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding CpuName}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Graphics}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding GpuName}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Memory}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding MemoryText}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Display}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding DisplayText}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Motherboard}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding BoardText}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="BIOS" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding BiosText}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="Windows" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding WindowsText}" /></DockPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,4,0,12" />
                            <DockPanel Margin="0,0,0,6"><TextBlock Text="{l:T SystemDrive}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding StorageText}" /></DockPanel>
                            <ProgressBar Value="{Binding StorageUsedPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="120,0,0,12" />
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T PowerPlan}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding PowerPlan}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T StartupApps}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding StartupCount}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Processes}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding ProcessCount}" /></DockPanel>
                            <DockPanel><TextBlock Text="{l:T Uptime}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding Uptime}" /></DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
