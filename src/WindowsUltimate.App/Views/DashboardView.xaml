<UserControl x:Class="WindowsUltimate.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WindowsUltimate.App.Localization"
             xmlns:ui="clr-namespace:WindowsUltimate.App.Controls">
    <UserControl.Resources>
        <!-- Live usage panel header: coloured chip + label (+ optional right-hand detail) -->
        <Style x:Key="LiveCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16,18,14" />
        </Style>
        <Style x:Key="Pct" TargetType="Run">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource B.TextTertiary}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <!-- ── Row 1: health (L3 hero) + live usage + recommendations ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Health score -->
                <Border Style="{StaticResource GlassCard}" Padding="22,20,22,18">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Visibility="{Binding HasReport, Converter={StaticResource Vis}}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                            <Setter Property="Text" Value="{l:T QuickScan}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFullScan}" Value="True">
                                                    <Setter Property="Text" Value="{l:T FullAnalysis}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{l:T SystemHealth}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Width="236" Height="236" Margin="0,10,0,4">
                            <ui:RingGauge Value="{Binding Score}" Maximum="100" Thickness="13" ShowTicks="True" Brush="{Binding Score, Converter={StaticResource ScoreBrush}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Score}" FontFamily="{StaticResource F.Display}" FontSize="60" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{StaticResource B.TitleText}" Visibility="{Binding HasReport, Converter={StaticResource Vis}}" />
                                <TextBlock Text="—" FontFamily="{StaticResource F.Display}" FontSize="60" HorizontalAlignment="Center" Foreground="{StaticResource B.TextTertiary}"
                                           Visibility="{Binding HasReport, Converter={StaticResource NotVis}}" />
                                <TextBlock Text="{Binding ScoreLabel}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{Binding Score, Converter={StaticResource ScoreBrush}}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Text.Caption}" FontWeight="Normal" HorizontalAlignment="Center" TextAlignment="Center" />
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Button Content="{l:T QuickScan}" Command="{Binding QuickScanCommand}" Style="{StaticResource Btn.Primary}" Margin="0,0,5,0" Padding="14,9" />
                            <Button Content="{l:T FullAnalysis}" Command="{Binding FullScanCommand}" Margin="5,0,0,0" Padding="14,9" />
                        </UniformGrid>
                        <Button Content="{l:T HowScoreWorks}" Command="{Binding ToggleMethodologyCommand}" Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <Border Style="{StaticResource Well}" Margin="0,10,0,0" Visibility="{Binding ShowMethodology, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Methodology}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding Penalties}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ScorePenalty, StringFormat=−{0}}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource B.Warning}" />
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Live usage -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource LiveCard}" Margin="0,0,8,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Style="{StaticResource IconChip}" Width="26" Height="26" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE950;" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource B.AccentBright}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CpuTemp}" Style="{StaticResource Text.Caption}" FontWeight="Normal" VerticalAlignment="Center" ToolTip="{l:T CpuTempNote}" />
                                    <TextBlock Text="CPU" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Metric}" Margin="0,12,0,0">
                                    <Run Text="{Binding CpuPercent, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text="%" Style="{StaticResource Pct}" />
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Top" Text=" " Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                                <ui:SparkChart Values="{Binding CpuHistory}" Maximum="100" Capacity="60" Stroke="{StaticResource B.Accent}" ShowGrid="True" MinHeight="78" Margin="0,10,0,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource LiveCard}" Margin="4,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Style="{StaticResource IconChip}" Background="{StaticResource B.VioletSoft}" Width="26" Height="26" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xF211;" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource B.Violet}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding GpuTemp}" Style="{StaticResource Text.Caption}" FontWeight="Normal" VerticalAlignment="Center" />
                                    <TextBlock Text="GPU" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Metric}" Margin="0,12,0,0">
                                    <Run Text="{Binding GpuPercent, StringFormat={}{0:0}, TargetNullValue=—, Mode=OneWay}" /><Run Text="%" Style="{StaticResource Pct}" />
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding VramText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                                <ui:SparkChart Values="{Binding GpuHistory}" Maximum="100" Capacity="60" Stroke="{StaticResource B.Violet}" ShowGrid="True" MinHeight="78" Margin="0,10,0,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource LiveCard}" Margin="8,0,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Style="{StaticResource IconChip}" Background="{StaticResource B.SuccessSoft}" Width="26" Height="26" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEEA0;" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource B.Success}" />
                                    </Border>
                                    <TextBlock Text="{l:T Memory}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Metric}" Margin="0,12,0,0">
                                    <Run Text="{Binding RamPercent, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text="%" Style="{StaticResource Pct}" />
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding RamUsedText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                                <ui:SparkChart Values="{Binding RamHistory}" Maximum="100" Capacity="60" Stroke="{StaticResource B.Success}" ShowGrid="True" MinHeight="78" Margin="0,10,0,0" />
                            </DockPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Safe recommendations (L3, accent light) -->
                    <Border Grid.Row="2" Style="{StaticResource AccentCard}" Padding="20,18">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding ApplySafeCommand}" Style="{StaticResource Btn.Primary}" VerticalAlignment="Center" Margin="16,0,0,0" Padding="16,9">
                                <TextBlock><Run Text="{l:T ReviewAndApply}" /><Run Text=" (" /><Run Text="{Binding SafeCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </Button>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Width="40" Height="40" CornerRadius="12" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource B.AccentBright}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T SafeRecommendations}" Style="{StaticResource Text.Section}" />
                                <TextBlock Text="{Binding SafeSummary}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{l:T SafeRecommendationsNote}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ── Row 2: findings + this PC ── -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" FontWeight="Normal" VerticalAlignment="Center"
                                       Text="{Binding Findings.Count, StringFormat={}{0}}" Visibility="{Binding HasReport, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{l:T WhatWeFound}" Style="{StaticResource Text.Section}" />
                        </DockPanel>
                        <!-- Loading skeleton while the first scan runs -->
                        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource NotVis}}">
                            <TextBlock Text="{l:T ScanRunning}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,12" />
                            <ui:Skeleton Height="58" Margin="0,0,0,8" CornerRadius="10" />
                            <ui:Skeleton Height="58" Margin="0,0,0,8" CornerRadius="10" Opacity="0.7" />
                            <ui:Skeleton Height="58" CornerRadius="10" Opacity="0.45" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Findings}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource IconChip}" Width="26" Height="26" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource B.AccentBright}" />
                            </Border>
                            <TextBlock Text="{l:T ThisPc}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </StackPanel.Resources>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Processor}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding CpuName}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Graphics}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding GpuName}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Memory}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding MemoryText}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Display}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding DisplayText}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Motherboard}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding BoardText}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="BIOS" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding BiosText}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="Windows" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding WindowsText}" /></DockPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,4,0,12" />
                            <DockPanel Margin="0,0,0,7"><TextBlock Text="{l:T SystemDrive}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding StorageText}" /></DockPanel>
                            <ProgressBar Value="{Binding StorageUsedPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="120,0,0,12" />
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T PowerPlan}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding PowerPlan}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T StartupApps}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding StartupCount}" /></DockPanel>
                            <DockPanel Margin="0,0,0,9"><TextBlock Text="{l:T Processes}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding ProcessCount}" /></DockPanel>
                            <DockPanel><TextBlock Text="{l:T Uptime}" Style="{StaticResource KvKey}" /><TextBlock Text="{Binding Uptime}" /></DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
