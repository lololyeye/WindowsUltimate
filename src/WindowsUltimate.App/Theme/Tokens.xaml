<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: deep graphite surfaces, one blue accent, semantic status colours. -->
    <Color x:Key="C.Window">#FF090B0F</Color>
    <Color x:Key="C.Sidebar">#FF0C0F14</Color>
    <Color x:Key="C.Surface">#FF11151C</Color>
    <Color x:Key="C.SurfaceAlt">#FF161B24</Color>
    <Color x:Key="C.Hover">#FF1C2230</Color>
    <Color x:Key="C.Pressed">#FF222A3A</Color>
    <Color x:Key="C.Border">#FF1F2631</Color>
    <Color x:Key="C.BorderStrong">#FF2C3544</Color>
    <Color x:Key="C.Text">#FFE9EDF3</Color>
    <Color x:Key="C.TextSecondary">#FF9CA6B5</Color>
    <Color x:Key="C.TextTertiary">#FF677385</Color>
    <Color x:Key="C.Accent">#FF4D8DFF</Color>
    <Color x:Key="C.AccentHover">#FF6A9FFF</Color>
    <Color x:Key="C.AccentDeep">#FF2F64E0</Color>
    <Color x:Key="C.Violet">#FF8B6CFF</Color>
    <Color x:Key="C.Success">#FF34D399</Color>
    <Color x:Key="C.Warning">#FFF5B83D</Color>
    <Color x:Key="C.Danger">#FFF2645C</Color>
    <Color x:Key="C.Info">#FF60A5FA</Color>

    <SolidColorBrush x:Key="B.Window" Color="{StaticResource C.Window}" />
    <SolidColorBrush x:Key="B.Sidebar" Color="{StaticResource C.Sidebar}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="B.Pressed" Color="{StaticResource C.Pressed}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="{StaticResource C.TextSecondary}" />
    <SolidColorBrush x:Key="B.TextTertiary" Color="{StaticResource C.TextTertiary}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentHover" Color="{StaticResource C.AccentHover}" />
    <SolidColorBrush x:Key="B.Violet" Color="{StaticResource C.Violet}" />
    <SolidColorBrush x:Key="B.Success" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="B.Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="B.Info" Color="{StaticResource C.Info}" />

    <SolidColorBrush x:Key="B.AccentSoft" Color="#264D8DFF" />
    <SolidColorBrush x:Key="B.SuccessSoft" Color="#1F34D399" />
    <SolidColorBrush x:Key="B.WarningSoft" Color="#1FF5B83D" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="#1FF2645C" />
    <SolidColorBrush x:Key="B.InfoSoft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="B.NeutralSoft" Color="#14FFFFFF" />

    <LinearGradientBrush x:Key="B.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5B97FF" Offset="0" />
        <GradientStop Color="#FF3A6CF0" Offset="1" />
    </LinearGradientBrush>

    <!-- Glass surfaces: translucent fill + a hairline highlight on the top edge. Used sparingly (hero, sidebar). -->
    <LinearGradientBrush x:Key="B.Glass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6141923" Offset="0" />
        <GradientStop Color="#D90F131A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.GlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#0FFFFFFF" Offset="0.35" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="B.GlowBlue" Center="0.12,0.0" GradientOrigin="0.12,0.0" RadiusX="0.7" RadiusY="0.9">
        <GradientStop Color="#2B3B6FE8" Offset="0" />
        <GradientStop Color="#00090B0F" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="B.GlowViolet" Center="1.0,1.0" GradientOrigin="1.0,1.0" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="#1A7A5CFF" Offset="0" />
        <GradientStop Color="#00090B0F" Offset="1" />
    </RadialGradientBrush>

    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="R.Card">12</CornerRadius>
    <CornerRadius x:Key="R.Control">8</CornerRadius>
    <CornerRadius x:Key="R.Small">6</CornerRadius>

</ResourceDictionary>
