<d:DialogBase x:Class="WindowsUltimate.App.Dialogs.ConfirmDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="clr-namespace:WindowsUltimate.App.Dialogs"
              xmlns:l="clr-namespace:WindowsUltimate.App.Localization"
              Width="580" Title="Confirm">
    <Border Background="{StaticResource B.Glass4}" BorderBrush="{StaticResource B.Edge4}" BorderThickness="1" CornerRadius="16" Margin="24,16,24,36">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.6" Color="Black" RenderingBias="Performance" />
        </Border.Effect>
        <StackPanel Margin="26,24">
            <DockPanel>
                <Border x:Name="IconHost" Width="34" Height="34" CornerRadius="9" Background="{StaticResource B.AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE946;" HorizontalAlignment="Center" Foreground="{StaticResource B.Accent}" />
                </Border>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
            <Border x:Name="DetailsHost" Style="{StaticResource Well}" Margin="48,14,0,0" Visibility="Collapsed">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsText" Style="{StaticResource Text.Secondary}" />
                </ScrollViewer>
            </Border>
            <CheckBox x:Name="AckBox" Margin="48,14,0,0" Visibility="Collapsed" Checked="OnAck" Unchecked="OnAck">
                <TextBlock x:Name="AckText" TextWrapping="Wrap" Foreground="{StaticResource B.Warning}" MaxWidth="420" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="{l:T Cancel}" Click="OnCancel" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Btn.Primary}" Click="OnConfirm" Margin="8,0,0,0" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</d:DialogBase>
