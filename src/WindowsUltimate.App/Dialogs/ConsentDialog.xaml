<d:DialogBase x:Class="WindowsUltimate.App.Dialogs.ConsentDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="clr-namespace:WindowsUltimate.App.Dialogs"
              xmlns:l="clr-namespace:WindowsUltimate.App.Localization"
              xmlns:c="clr-namespace:WindowsUltimate.App.Converters"
              Width="700" Title="Review changes">
    <Window.Resources>
        <c:RiskToBrush x:Key="RiskBrush" />
        <c:RiskToBrush x:Key="RiskSoft" Soft="True" />
        <c:RiskToLabel x:Key="RiskLabel" />
        <c:BoolToVisibility x:Key="Vis" />
    </Window.Resources>
    <Border Background="{StaticResource B.Glass4}" BorderBrush="{StaticResource B.Edge4}" BorderThickness="1" CornerRadius="16" Margin="24,16,24,36">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.6" Color="Black" RenderingBias="Performance" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="26,24,26,14">
                <TextBlock Text="{l:T ConsentHeader}" Style="{StaticResource Text.Caption}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" FontSize="19" Margin="0,4,0,6" />
                <TextBlock Text="{l:T ConsentIntro}" Style="{StaticResource Text.Secondary}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="430" VerticalScrollBarVisibility="Auto" Margin="26,0,14,0" Padding="0,0,12,0">
                <StackPanel>
                    <ItemsControl x:Name="Items">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,8" Padding="16,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding Risk, Converter={StaticResource RiskSoft}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Risk, Converter={StaticResource RiskLabel}}" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding WhatItChanges}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,8" />
                                        <ItemsControl ItemsSource="{Binding Changes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Location}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" Margin="12,0,0,0">
                                                            <Run Text="{Binding From, Mode=OneWay}" Foreground="{StaticResource B.TextTertiary}" />
                                                            <Run Text=" → " />
                                                            <Run Text="{Binding To, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,14,0" Text="{Binding RestartText}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ReversibleText}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Disadvantages}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource B.Warning}" Margin="0,6,0,0"
                                                   Visibility="{Binding ShowDisadvantages, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="BlockedPanel" Style="{StaticResource Well}" Background="{StaticResource B.WarningSoft}" Margin="0,4,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{l:T ConsentSkipped}" Style="{StaticResource Text.Section}" Foreground="{StaticResource B.Warning}" />
                            <TextBlock x:Name="BlockedText" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="26,16" Margin="0,8,0,0">
                <StackPanel>
                    <CheckBox x:Name="RestorePointBox" Content="{l:T ConsentRestorePoint}" />
                    <TextBlock x:Name="RestorePointNote" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="26,3,0,0" />
                    <CheckBox x:Name="AckBox" Margin="0,10,0,0" Visibility="Collapsed" Checked="OnAckChanged" Unchecked="OnAckChanged">
                        <TextBlock Text="{l:T ConsentAcknowledge}" TextWrapping="Wrap" Foreground="{StaticResource B.Warning}" MaxWidth="560" />
                    </CheckBox>
                    <DockPanel Margin="0,16,0,0" LastChildFill="False">
                        <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Click="OnApply" IsDefault="True" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="{l:T Cancel}" Click="OnCancel" IsCancel="True" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</d:DialogBase>
